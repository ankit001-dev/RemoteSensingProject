
@{
    Model.Title = "Dashboard";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
    var data = Model as RemoteSensingProject.Models.Admin.main.DashboardCount;
    var graphdata = ViewData["physical"] as List<RemoteSensingProject.Models.Admin.main.Project_model>;
}
<style>
    a:hover {
        color: #029e9d !important;
    }
</style>
<div class="row mx-0">
    <div class="col-12 col-xl-12">
        <div class="row flex-grow-1">

            <!-- Total Budget Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1 ">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Budget's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-12">
                                    <h6 class="mb-2 text-success"></h6>
                                    <div class="d-flex align-items-baseline">
                                        <a href="/Admin/ViewExpenditureAmount">
                                            <p class="text-success w-100 inst py-0">
                                                <span>
                                                    <span class="text-dark">Total Budget :  </span> ₹
                                                    @Convert.ToDecimal(data.TotalBudget).ToString("N2")
                                                </span>
                                            </p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <a href="/Admin/ViewExpenditureAmount?statusFilter=expenditure">
                                            <p class="text-success w-100 py-0">
                                                <span>
                                                    <span class="text-dark">Expenditure : </span> ₹
                                                    @Convert.ToDecimal(data.expenditure).ToString("N2")
                                                </span>
                                            </p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <a href="/Admin/ViewExpenditureAmount?statusFilter=remaining">
                                            <p class="text-success w-100 py-0">
                                                <span>
                                                    <span class="text-dark">Remaining : </span>₹
                                                    @Convert.ToDecimal(data.PendingBudget).ToString("N2")
                                                </span>
                                            </p>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project's Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Total Project's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-7">
                                    <h6 class="mb-2 text-success"></h6>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?typeFilter=Internal">
                                            <p class="text-success w-100"><span><span class="text-dark">Internal  :  </span> @data.TotalInternalProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?typeFilter=External">
                                            <p class="text-success w-100"><span><span class="text-dark">External  :  </span> @data.TotalExternalProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects">
                                            <p class="text-success w-100"><span><span class="text-dark">Total  :  </span> @data.TotalProject</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-5 pt-2">
                                    <img src="~/assets/gif/file.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Internal Project's Status Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Internal Project's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-7">
                                    <h6 class="mb-2 text-success"></h6>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=Ongoing&typeFilter=Internal">
                                            <p class="text-success w-100"><span><span class="text-dark">Ongoing : </span> @data.TotalOngoingProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=Complete&typeFilter=Internal">
                                            <p class="text-success w-100"><span><span class="text-dark">Complete : </span>@data.TotalCompleteProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=delay&typeFilter=Internal">
                                            <p class="text-success w-100"><span><span class="text-dark">Delay :  </span> @data.TotalDelayproject</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-5 pt-2">
                                    <img src="~/assets/gif/file.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- External Project's Status Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">External Project's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-7">
                                    <h6 class="mb-2 text-success"></h6>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=Ongoing&typeFilter=External">
                                            <p class="text-success w-100"><span><span class="text-dark">Ongoing : </span> @data.ExternalOngoingProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=Complete&typeFilter=External">
                                            <p class="text-success w-100"><span><span class="text-dark">Complete : </span>@data.ExternalCompletedProject</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/admin/All_Projects?statusFilter=delay&typeFilter=External">
                                            <p class="text-success w-100"><span><span class="text-dark">Delay : </span> @data.ExternalDelayProject</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-5 pt-2">
                                    <img src="~/assets/gif/file.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Meeting's Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Meeting's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-8">
                                    <h3 class="mb-2 text-success"></h3>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Meeting_Report">
                                            <p class="text-success w-100"><span><span class="text-dark">Total :  </span> @data.TotalMeetings</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Meeting_Report?statusFilter=admin">
                                            <p class="text-success w-100"><span><span class="text-dark">Admin :  </span> @data.TotalAdminMeetings</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Meeting_Report?statusFilter=projectmanager">
                                            <p class="text-success w-100"><span><span class="text-dark">Project Manager :  </span> @data.TotalProjectManagerMeetings</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-4">
                                    <img src="~/assets/gif/discussion.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Employee Card-->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Employee's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-8">
                                    <h3 class="mb-2 text-success"></h3>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Employee_Registration">
                                            <p class="text-success w-100"><span><span class="text-dark">Total :  </span> @data.TotalEmployeesCount</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Employee_Registration?filterType=divisionHead">
                                            <p class="text-success w-100"><span><span class="text-dark">Division Head :  </span> @data.TotalDivisionHeadCount</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Employee_Registration?filterType=projectManager">
                                            <p class="text-success w-100"><span><span class="text-dark">Project Manager :  </span> @data.TotalProjectManagerCount</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-4">
                                    <img src="~/assets/gif/discussion.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!--Category Card-->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <h6 class="card-title mb-0 text-nowrap">Category's</h6>
                            </div>
                            <div class="row">
                                <div class="col-6 col-md-12 col-xl-8">
                                    <h3 class="mb-2 text-success"></h3>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Emp_Category?tab=division">
                                            <p class="text-success w-100"><span><span class="text-dark">Division :  </span> @data.TotalDivisionCount</span></p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline ">
                                        <a href="/Admin/Emp_Category?tab=designation">
                                            <p class="text-success w-100"><span><span class="text-dark">Designation :  </span> @data.TotalDesignationCount</span></p>
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6 col-md-12 col-xl-4">
                                    <img src="~/assets/gif/discussion.gif" height="60" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<style>

    .card-chart-mini {
        max-width: 265px;
        max-height: 150px !important;
    }
</style>
<!--Mini charts-->
<div class="row mx-0">
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">Budget</div>
            <div class="card-body">
                <div>
                    <canvas id="bbchart" style="min-height: 200px; max-height: 200px; width: 264px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">Project</div>
            <div class="card-body">
                <div>
                    <canvas id="pichart" style="max-height:200px; width:264px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Mini charts-->

<div class="row mx-0 mt-1">
    <div class="col-12 px-1 ">
        <div class="card ">
            <div class="card-body">
                <div id="monthlySalesChart"></div>
            </div>
        </div>
    </div>
</div>




<div class="row mx-0 my-1">
    <div class="col-sm-12 px-1">
        <div class="card ">
            <div class="card-header">
                <b>Physical Chart</b>
            </div>
            <div class="card-body">
                <div>
                    <canvas id="myBarChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 px-1">
        <div class="card ">
            <div class="card-header">
                <b>Financial Chart</b>
            </div>
            <div class="card-body">
                <div>
                    <canvas id="stackedBarLineChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>





<script defer>
document.addEventListener("DOMContentLoaded", function () {

    /* =======================
       GLOBAL DEFAULTS
    ======================== */
    Chart.defaults.font.size = 13;
    Chart.defaults.font.family = "'Segoe UI', sans-serif";
    Chart.defaults.color = '#000';

    const graphData = @Html.Raw(Json.Encode(graphdata));
    const budgetData = @Html.Raw(Json.Encode(ViewData["budgetGraph"]));

    /* =======================
       1️⃣ Radial Chart
    ======================== */
    const storageChartEl = document.querySelector("#storageChart");
    if (storageChartEl) {
        new ApexCharts(storageChartEl, {
            chart: {
                height: 260,
                type: "radialBar",
                events: {
                    click: () => window.location.href = "/Admin/All_Projects"
                }
            },
            series: [@data.TotalCompleteProject],
            colors: ['#029e9d'],
            plotOptions: {
                radialBar: {
                    hollow: { size: "70%" },
                    dataLabels: {
                        value: { fontSize: "30px" }
                    }
                }
            },
            labels: ["Project Data"]
        }).render();
    }

    /* =======================
       2️⃣ Apex Bar Chart
    ======================== */
    const monthlyChartEl = document.querySelector("#monthlySalesChart");

    if (monthlyChartEl && graphData) {

        const fullLabels = graphData.map(x => x.ProjectTitle);
        const overall = graphData.map(x => x.overallPercentage);

        new ApexCharts(monthlyChartEl, {
            chart: {
                type: 'bar',
                height: 318
            },
            colors: ['#1aa7a6'],
            series: [{
                name: 'Completed',
                data: overall
            }],
            xaxis: {
                categories: fullLabels,
                labels: {
                    formatter: function (value) {
                        return value.length > 18
                            ? value.substring(0, 18) + "..."
                            : value;
                    }
                }
            },
            tooltip: {
                x: {
                    formatter: function (value, { dataPointIndex }) {
                        return fullLabels[dataPointIndex]; // 👈 full label on hover
                    }
                }
            },
            yaxis: {
                min: 0,
                max: 100
            }
        }).render();
    }

    /* =======================
       3️⃣ Physical Chart
    ======================== */
    createBarChart("myBarChart", graphData, "physicalcomplete", "rgba(54,162,235,0.5)", "Physical %");

    createBarChart("stackedBarLineChart", graphData, "Percentage", "rgba(255,99,132,0.5)", "Financial %");

    function createBarChart(elementId, dataArray, valueKey, color, labelName) {

        const el = document.getElementById(elementId);
        if (!el || !dataArray) return;

        const fullLabels = dataArray.map(x => x.ProjectTitle);

        new Chart(el, {
            type: 'bar',
            data: {
                labels: fullLabels,
                datasets: [{
                    label: labelName,
                    data: dataArray.map(x => x[valueKey]),
                    backgroundColor: color
                }]
            },
            options: {
                responsive: true,
                scales: {
                    x: {
                        ticks: {
                            callback: function (value, index) {
                                const label = fullLabels[index];
                                return label.length > 18
                                    ? label.substring(0, 18) + '...'
                                    : label;
                            }
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            title: function (tooltipItems) {
                                return fullLabels[tooltipItems[0].dataIndex];
                            }
                        }
                    }
                }
            }
        });
    }
    /* =======================
       5️⃣ Budget Radar
    ======================== */
    const budgetEl = document.getElementById("bbchart");
    if (budgetEl && budgetData && budgetData.length > 0) {

        const labels = budgetData.map(x => x.ProjectName);

        const datasets = [
            {
                label: "Total Budget",
                data: budgetData.map(x => x.ProjectBudget),
                backgroundColor: 'rgba(54,162,235,0.2)',
                borderColor: 'rgba(54,162,235,1)'
            },
            {
                label: "Expenditure",
                data: budgetData.map(x => x.expenditure),
                backgroundColor: 'rgba(255,99,132,0.2)',
                borderColor: 'rgba(255,99,132,1)'
            },
            {
                label: "Pending Budget",
                data: budgetData.map(x => x.remaining),
                backgroundColor: 'rgba(255,206,86,0.2)',
                borderColor: 'rgba(255,206,86,1)'
            }
        ];

        new Chart(budgetEl, {
            type: 'radar',
            data: { labels, datasets }
        });
    }

    /* =======================
       6️⃣ Pie Chart
    ======================== */
    const pieEl = document.getElementById("pichart");
    if (pieEl) {
        new Chart(pieEl, {
            type: 'pie',
            data: {
                labels: ['Total', 'Internal', 'External'],
                datasets: [{
                    data: [
                        @Convert.ToInt32(data.TotalProject),
                        @Convert.ToInt32(data.TotalInternalProject),
                        @Convert.ToInt32(data.TotalExternalProject)
                    ],
                    backgroundColor: ['#4bd6e7', '#84a0eb', '#9db4c7']
                }]
            }
        });
    }

});
</script>

