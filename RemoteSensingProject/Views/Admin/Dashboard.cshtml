<style>

    .card-chart-mini {
        max-width: 265px;
        max-height: 150px !important;
    }
</style>
<!--Mini charts-->
<div class="row mx-0">
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">Budget</div>
            <div class="card-body">
                <div>
                    <canvas id="bbchart" style="min-height: 200px; max-height: 200px; width: 264px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">Project</div>
            <div class="card-body">
                <div>
                    <canvas id="pichart" style="max-height:200px; width:264px;"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>
<!--Mini charts-->

<div class="row mx-0 mt-1">
    <div class="col-lg-7 col-xl-8 px-1 ">
        <div class="card ">
            <div class="card-body">
                <div id="monthlySalesChart"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-xl-4 px-1 ">
        <div class="card ">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline">
                    <h6 class="card-title mb-0">Project Data</h6>
                </div>
                <div id="storageChart"></div>
                <div class="row mb-4">
                    <div class="col-6 d-flex justify-content-end">
                        <div>
                            <label class="d-flex align-items-center justify-content-end tx-10 text-uppercase fw-bolder">Total Projects <span class="p-1 ms-1 rounded-circle bg-secondary"></span></label>
                            <h5 class="fw-bolder mb-0 text-end">@data.TotalProject</h5>
                        </div>
                    </div>
                    <div class="col-6">
                        <div>
                            <label class="d-flex align-items-center tx-10 text-uppercase fw-bolder"><span class="p-1 me-1 rounded-circle bg-primary"></span> Completed Projects</label>
                            <h5 class="fw-bolder mb-0">@data.TotalCompleteProject</h5>
                        </div>
                    </div>
                </div>
                @*<div class="d-grid">
                        <button class="btn btn-primary">View More</button>
                    </div>*@
            </div>
        </div>
    </div>
</div>




<div class="row mx-0 my-1">
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">
                <b>Physical Chart</b>
            </div>
            <div class="card-body">
                <div>
                    <canvas id="myBarChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 px-1">
        <div class="card ">
            <div class="card-header">
                <b>Financial Chart</b>
            </div>
            <div class="card-body">
                <div>
                    <canvas id="stackedBarLineChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
@*<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>*@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const graphData = @Html.Raw(Json.Encode(graphdata));
    const budgetData = @Html.Raw(Json.Encode(ViewData["budgetGraph"] ?? new List<object>()));
    const totalComplete = @data.TotalCompleteProject;

    function initRadialChart() {

        if (!$('#storageChart').length) return;

        var options = {
            chart: {
                height: 260,
                type: "radialBar",
                events: {
                    click: function () {
                        window.location.href = "/Admin/All_Projects";
                    }
                }
            },
            series: [totalComplete],
            colors: ['#029e9d'],
            plotOptions: {
                radialBar: {
                    hollow: { size: "70%" },
                    dataLabels: {
                        name: { show: true },
                        value: { fontSize: "30px" }
                    }
                }
            },
            labels: ["Project Data"]
        };

        new ApexCharts(document.querySelector("#storageChart"), options).render();
    }
    function initPhysicalChart() {

        if (!graphData || graphData.length === 0) return;

        var options = {
            chart: {
                type: 'bar',
                height: graphData.length * 40
            },
            plotOptions: {
                bar: {
                    horizontal: true,
                    borderRadius: 4
                }
            },
            series: [{
                data: graphData.map(x => ({
                    x: x.ProjectTitle,
                    y: x.overallPercentage
                }))
            }],
            xaxis: {
                max: 100
            },
            yaxis: {
                labels: {
                    style: {
                        fontSize: '11px'
                    }
                }
            }
        };

        new ApexCharts(document.querySelector("#monthlySalesChart"), options).render();
    }

    function initFinancialChart() {

        if (!graphData || graphData.length === 0) return;

        new Chart(document.getElementById('stackedBarLineChart'), {
            type: 'bar',
            data: {
                labels: graphData.map(x => x.ProjectTitle),
                datasets: [{
                    data: graphData.map(x => x.Percentage),
                    backgroundColor: 'rgba(255,99,132,0.5)'
                }]
            },
            options: {
                responsive: true
            }
        });
    }
    function initRadarChart() {

        if (!budgetData || budgetData.length === 0) return;

        new Chart(document.getElementById('bbchart'), {
            type: 'radar',
            data: {
                labels: budgetData.map(x => x.ProjectName),
                datasets: [
                    {
                        label: "Total Budget",
                        data: budgetData.map(x => x.ProjectBudget)
                    },
                    {
                        label: "Expenditure",
                        data: budgetData.map(x => x.expenditure)
                    },
                    {
                        label: "Pending Budget",
                        data: budgetData.map(x => x.remaining)
                    }
                ]
            }
        });
    }
function initPieChart() {

    new Chart(document.getElementById('pichart'), {
        type: 'pie',
        data: {
            labels: ['Total', 'Internal', 'External'],
            datasets: [{
                data: [
                    @Convert.ToInt32(data.TotalProject),
                    @Convert.ToInt32(data.TotalInternalProject),
                    @Convert.ToInt32(data.TotalExternalProject)
                ]
            }]
        }
    });
}

    $(document).ready(function () {

        initRadialChart();
        initPhysicalChart();
        initFinancialChart();
        initRadarChart();
        initPieChart();

    });

</script>
