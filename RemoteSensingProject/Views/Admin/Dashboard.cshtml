                                                </span>
                                            </p>
                                        </a>
                                    </div>
                                    <div class="d-flex align-items-baseline">
                                        <a href="/Admin/ViewExpenditureAmount?statusFilter=remaining">
                                            <p class="text-success w-100 py-0">
                                                <span>
                                                    <span class="text-dark">Remaining : </span>₹
                                                    @Convert.ToDecimal(data.PendingBudget).ToString("N2")
                                                </span>
                                            </p>
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
