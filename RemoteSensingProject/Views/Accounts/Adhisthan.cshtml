
@{
    ViewBag.Title = "Adhisthan";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var list = ViewData["adhisthanList"] as List<RemoteSensingProject.Models.Accounts.main.AdhisthanModel>;
}
<style>
    tr{
        border:2px solid black !important;
    }
</style>
<nav class="page-breadcrumb d-flex align-items-center justify-content-end">
    <button class="btn btn-inverse-primary" id="downloadDocx"><i class="link-icon" data-feather="download"></i>Export Docx</button> &nbsp; &nbsp;
    <button class="btn btn-primary" id="addAdhisthanModalBtn"><i class="link-icon" data-feather="plus"></i>Add Adhisthan</button>
</nav>
<div class="table-responsive">
            <div class="pt-2">
                <h4 class="text-center">रिमोट सेन्सिंग एप्लीकेशन्स सेन्टर, उत्तर प्रदेश</h4>
                <p class="fw-boldest text-center">वित्तीय वर्ष 2025-26 में अधिष्ठान मद के अन्तर्गत प्राविधान धनराशि का विवरण</p>
                <p class="text-end pe-4">(रू0 लाख में)</p>
            </div>
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="pt-0 border border-dark border-r fw-bold">क्र0सं0</th>
                        <th class="pt-0 border border-dark border-r fw-bold">मद का नाम</th>
                        <th class="pt-0 border border-dark border-r fw-bold">बजट प्राविधान</th>
                        <th class="pt-0 border border-dark border-r fw-bold">व्यय धनराशि</th>
                        <th class="pt-0 border border-dark border-r fw-bold">व्यय प्रतिशत</th>
                        <th class="pt-0 border border-dark border-r fw-bold">Committed</th>
                        <th class="pt-0 border border-dark border-r fw-bold">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list != null && list.Count > 0)
                     {
                        int count = 1;
                        foreach (var d in list)
                        {
                            <tr>
                                <td class="border border-dark border-r">@count</td>
                                <td class="border border-dark border-r">
                                    <a data-id="@d.Id"
                                       data-headname="@d.HeadName"
                                       data-budget="@d.BudgetProvision"
                                       class="addExpenditure cursor-pointer" title="Add Expenditure">@d.HeadName</a>
                                </td>
                                <td class="border border-dark border-r">@d.BudgetProvision.ToString("N2")</td>
                                <td class="border border-dark border-r">@d.ExpenditureAmount.ToString("N2")</td>
                                <td class="border border-dark border-r">@d.ExpenditurePercentage</td>
                                <td class="border border-dark border-r">@d.Committed.ToString("N2")</td>
                                <td class="border border-dark border-r">
                                    <a class="cursor-pointer editAdhisthanBtn"
                                       data-bs-toggle="modal"
                                       data-bs-target="#addslider"
                                       data-id="@d.Id"
                                       data-name="@d.HeadName"
                                       data-committed="@d.Committed.ToString("N2")"
                                       title="Edit Adhisthan"
                                       data-budget="@d.BudgetProvision.ToString("N2")">
                                        <i class="link-icon" data-feather="edit"></i>
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                </tbody>
            </table>
        </div>

<!--Add Adhisthan Modal-->
<div class="modal fade" id="adhisthanModal" tabindex="-1" aria-labelledby="adhisthanModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>

                <h5 class="modal-title" id="exampleModalLabel">Manage Adhisthan</h5>

            </div>
            <div class="modal-body">
                <form id="addAdhisthanForm">
                    <input type="hidden" id="adhisthanId" name="Id" value="0" />

                    <div class="form-group">
                        <label for="headName" class="form-label">Head Name</label>
                        <input type="text" class="form-control" name="HeadName" required id="headName" placeholder="Enter Head Name">
                    </div>
                    <div class="form-group mt-1">
                        <label for="budgetProvision" class="form-label">Budget Provision (in Lakhs)</label>
                        <input type="text" class="form-control" name="BudgetProvision" required id="budgetProvision" placeholder="Enter Budget">
                    </div>
                    <div class="form-group mt-1">
                        <label for="committed" class="form-label">Committed Amount (in Lakhs)</label>
                        <input type="text" class="form-control" name="Committed" required id="committed" placeholder="Enter committed amount">
                    </div>
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary"><i class="link-icon" data-feather="plus"></i><span class="actionType">Submit</span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!--Add Expenditure Modal-->
<div class="modal fade" id="addExpenditureModal" tabindex="-1" aria-labelledby="addExpenditureModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>

                <h5 class="modal-title" id="exampleModalLabel">Add Expenditure</h5>

            </div>
            <div class="modal-body">
                <form id="addExpenditureForm">
                    <input type="hidden" id="adhisthan" name="Id" value="0" />

                    <div class="form-group">
                        <label for="heads" class="form-label">Head Name</label>
                        <input type="text" class="form-control" readonly id="heads">
                    </div>
                    <div class="form-group mt-1">
                        <label for="budget" class="form-label">Budget Provision (in Lakhs)</label>
                        <input type="text" class="form-control" id="budget" readonly>
                    </div>
                    <div class="form-group mt-1">
                        <label for="Expenditure" class="form-label">Expenditure (in Lakhs)</label>
                        <input type="text" class="form-control" name="ExpenditureAmount" id="budgetProvision" placeholder="Enter expediture">
                    </div>
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary"><i class="link-icon" data-feather="plus"></i><span class="actionType">Submit</span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $('#addAdhisthanModalBtn').on('click', function () {

        $("#adhisthanId").val(0);
        $("#addAdhisthanForm")[0].reset();
        $(".actionType").text("Submit");

        $('#adhisthanModal').modal('show');
    });

    $('.addExpenditure').on('click', function () {
        let id = $(this).data('id');
        let headname = $(this).data('headname');
        let budget = $(this).data('budget');
        $('#adhisthan').val(id);
        $('#heads').val(headname);
        $('#budget').val(budget);

        $('#addExpenditureModal').modal('show');
    });

    $(document).on('click', '.editAdhisthanBtn', function () {

        let id = $(this).data('id');
        let name = $(this).data('name');
        let budget = $(this).data('budget');
        let committed = $(this).data('committed');

        $("#adhisthanId").val(id);
        $("#headName").val(name);
        $("#budgetProvision").val(budget);
        $("#committed").val(committed);

        $(".actionType").text("Update");

        $("#adhisthanModal").modal('show');
    });

    //Add Adhisthan 
    $("#addAdhisthanForm").on("submit", function (e) {
        e.preventDefault();
        Swal.fire({
            title: "Please wait !",
            text: "Processing your request....",
            timer: 100000,
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        let data = new FormData(this);
        $.ajax({
            url: "/accounts/InsertAdhisthan",
            type: "Post",
            data: data,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.status) {
                    Swal.fire({
                        title: "Successfuly !",
                        text: res.message,
                        icon: "success",
                        didClose: () => {
                            location.reload(true)
                        }
                    })
                } else {
                    Swal.fire({
                        title: "Sorry !",
                        text: res.message,
                        icon: "warning"
                    })
                }
            },
            error: function () {
                Swal.fire({
                    title: "Server issue",
                    text: "Server is not respondig. Please try after sometime.",
                    icon: "error",
                    didClose: () => {
                        location.reload(true)
                    }
                })
            }
        })
    })

    //Add Expenditure
    $("#addExpenditureForm").on("submit", function (e) {
        e.preventDefault();
        Swal.fire({
            title: "Please wait !",
            text: "Processing your request....",
            timer: 100000,
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        let data = new FormData(this);
        $.ajax({
            url: "/accounts/InsertExpenditure",
            type: "Post",
            data: data,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.status) {
                    Swal.fire({
                        title: "Successfuly !",
                        text: res.message,
                        icon: "success",
                        didClose: () => {
                            location.reload(true)
                        }
                    })
                } else {
                    Swal.fire({
                        title: "Sorry !",
                        text: res.message,
                        icon: "warning"
                    })
                }
            },
            error: function () {
                Swal.fire({
                    title: "Server issue",
                    text: "Server is not respondig. Please try after sometime.",
                    icon: "error",
                    didClose: () => {
                        location.reload(true)
                    }
                })
            }
        })
    }) 

    $("#downloadDocx").click(function () {
        $.ajax({
            url: '/api/report/AdhisthanAccountReportGenerator',
            type: 'GET',
            data: { month: 2, year: 2026},
            xhrFields: {
                responseType: 'blob'
            },
            success: function (data, status, xhr) {

                var contentDisposition = xhr.getResponseHeader('Content-Disposition');
                var fileName = "Report.docx"; // fallback

                if (contentDisposition) {

                    var fileNameMatch = contentDisposition.match(/filename\*=utf-8''(.+)/i);

                    if (fileNameMatch && fileNameMatch.length > 1) {
                        fileName = decodeURIComponent(fileNameMatch[1]);
                    }
                }

                var blob = new Blob([data], {
                    type: xhr.getResponseHeader("Content-Type")
                });

                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (err) {
                console.log(err);
                alert("Error downloading file");
            }
        });
    })
</script>