
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var bdata = ViewData["budgetdataforgraph"] as List<RemoteSensingProject.Models.Accounts.main.GraphData>;
    var data = ViewData["dashboardCount"] as RemoteSensingProject.Models.Accounts.main.DashboardCount;
}


<div class="row mx-0 mb-0">
    <div class="col-12 col-xl-12 mb-0">
        <div class="row flex-grow-1">

            <!-- Internal Project Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/accounts/internalproject" class="p-0">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0">Internal </h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-9">
                                        <div class="d-flex align-items-baseline mt-2">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Project :  </span> @data.TotalInternalProjectCount</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Fund :  </span> @data.TotalInternalProjectFund</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Expense :  </span> @data.TotalInternalExpense </span></p>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-3">
                                        <img src="~/assets/gif/success.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- External Project Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/accounts/externalproject">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0">External </h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-9">
                                        <div class="d-flex align-items-baseline mt-2">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Project :  </span> @data.TotalExternalProjectCount</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Fund :  </span> @data.TotalExternalProjectFund</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Total Expense :  </span> @data.TotalExternalExpense </span></p>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-3">
                                        <img src="~/assets/gif/success.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Adhisthan Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/accounts/Adhisthan">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0">Adhisthan </h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-9">
                                        <div class="d-flex align-items-baseline mt-2">
                                            <p class="text-success w-100"><span><span class="text-dark">Budget Provision :  </span> @data.TotalExternalProjectCount</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Expenditure in ₹ :  </span> @data.TotalExternalProjectFund</span></p>
                                        </div>
                                        <div class="d-flex align-items-baseline">
                                            <p class="text-success w-100"><span><span class="text-dark">Expenditure in % :  </span> @data.TotalExternalExpense </span></p>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-3">
                                        <img src="~/assets/gif/success.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tour Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/accounts/tourproposalrequest">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0 text-nowrap">Tour Proposal's</h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-9">
                                        <p class="fs-2 fw-bold pt-3 text-dark ps-5">@data.TotalTourCount</p>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-3">
                                        <img src="~/assets/gif/map.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container m-0 p-0">
    <div class="row g-3 align-items-stretch">

        <!-- ========== INTERNAL PROJECT LEFT ========== -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-primary mb-0">Internal Project</h5>
                    </div>

                    <p class="text-muted small">
                        Check the current fund status on the dashboard for detailed updates.
                    </p>

                    <div class="flex-grow-1">
                        <div id="internalMonthlyChart" style="height:100%; min-height:280px;"></div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========== INTERNAL PROJECT RIGHT ========== -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">

                    <h5 class="fw-bold text-primary mb-4">Internal Summary</h5>

                    <div id="internalStorageChart" class="mb-4" style="height:200px;"></div>

                    <div class="mt-auto">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <h6 class="text-muted small text-uppercase">Total Projects</h6>
                                <h4 class="fw-bold">@data.TotalInternalProjectCount</h4>
                            </div>
                            <div class="col-6">
                                <h6 class="text-muted small text-uppercase">Completed</h6>
                                <h4 class="fw-bold text-success">@data.TotalInternalCompletedProject</h4>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========== EXTERNAL PROJECT LEFT ========== -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-primary mb-0">External Project</h5>
                    </div>

                    <p class="text-muted small">
                        Check the current fund status on the dashboard for detailed updates.
                    </p>

                    <div class="flex-grow-1">
                        <div id="externalMonthlyChart" style="height:100%; min-height:280px;"></div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========== EXTERNAL PROJECT RIGHT ========== -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">

                    <h5 class="fw-bold text-primary mb-4">External Summary</h5>

                    <div id="externalStorageChart" class="mb-4" style="height:200px;"></div>

                    <div class="mt-auto">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <h6 class="text-muted small text-uppercase">Total Projects</h6>
                                <h4 class="fw-bold">@data.TotalExternalProjectCount</h4>
                            </div>
                            <div class="col-6">
                                <h6 class="text-muted small text-uppercase">Completed</h6>
                                <h4 class="fw-bold text-success">@data.TotalExternalCompletedProject</h4>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        var grouped = @Html.Raw(Json.Encode(ViewData["budgetdataforgraph"]));

        var internalData = grouped.Internal || [];
        var externalData = grouped.External || [];
        console.log(grouped);

        //Budget Chart
        //Internal
        if ($('#internalMonthlyChart').length && internalData.length) {

            var options = {
                chart: {
                    type: 'bar',
                    height: 318,
                    toolbar: { show: false }
                },

                colors: ['#1aa7a6', '#ffb22b', '#f17a7a'],

                legend: {
                    show: true,
                    position: 'top',
                    horizontalAlign: 'center'
                },

                series: [
                    { name: 'Total Fund', data: internalData.map(x => x.TotalFund) },
                    { name: 'Expense', data: internalData.map(x => x.TotalExpense) },
                    { name: 'Remaining', data: internalData.map(x => x.TotalRemaining) }
                ],

                xaxis: {
                    categories: internalData.map(x => x.ProjectCode), // check casing here
                    title: { text: "Project Code" },
                    labels: { rotate: -45 }
                },

                yaxis: {
                    title: { text: "Amount" }
                },

                dataLabels: {
                    enabled: true
                },

                plotOptions: {
                    bar: {
                        columnWidth: '55%',
                        borderRadius: 4
                    }
                }
            };

            new ApexCharts(document.querySelector("#internalMonthlyChart"), options).render();
        }



        //External
        if ($('#externalMonthlyChart').length && externalData.length) {

            var options = {
                chart: {
                    type: 'bar',
                    height: 318,
                    toolbar: { show: false }
                },

                colors: ['#1aa7a6', '#ffb22b', '#f17a7a'],

                legend: {
                    show: true,
                    position: 'top',
                    horizontalAlign: 'center'
                },

                series: [
                    { name: 'Total Fund', data: externalData.map(x => x.TotalFund) },
                    { name: 'Expense', data: externalData.map(x => x.TotalExpense) },
                    { name: 'Remaining', data: externalData.map(x => x.TotalRemaining) }
                ],

                xaxis: {
                    categories: externalData.map(x => x.ProjectCode), // check casing here
                    title: { text: "Project Code" },
                    labels: { rotate: -45 }
                },

                yaxis: {
                    title: { text: "Amount" }
                },

                dataLabels: {
                    enabled: true
                },

                plotOptions: {
                    bar: {
                        columnWidth: '55%',
                        borderRadius: 4
                    }
                }
            };

            new ApexCharts(document.querySelector("#externalMonthlyChart"), options).render();
        }

        //Storage Charts
        //Internal
        if ($('#internalStorageChart').length) {
            var totalProjects = @Html.Raw(Json.Encode(data.TotalInternalProjectCount));
            var completedProjects = @Html.Raw(Json.Encode(data.TotalInternalCompletedProject));
            var percentage = totalProjects > 0
                ? Math.round((completedProjects / totalProjects) * 100)
                : 0;
            var colors = {
                primary: '#029e9d', // Set the primary color to #029e9d
                light: '#f3f3f3',   // You can define other colors like light, muted, etc.
                muted: '#6c757d',
                bodyColor: '#212529'
            };
            var options = {
                chart: {
                    height: 260,
                    type: "radialBar",
                    events: {
                        // Listen for click event on the chart
                        click: function (event, chartContext, config) {
                            // Redirect based on the click event
                            window.location.href = "/accounts/Internaproject";  // Change this to your desired URL
                        }
                    }
                },
                series: [percentage],
                colors: [colors.primary],
                plotOptions: {
                    radialBar: {
                        hollow: {
                            margin: 15,
                            size: "70%"
                        },
                        track: {
                            show: true,
                            background: colors.light,
                            strokeWidth: '100%',
                            opacity: 1,
                            margin: 5,
                        },
                        dataLabels: {
                            showOn: "always",
                            name: {
                                offsetY: -11,
                                show: true,
                                color: colors.muted,
                                fontSize: "13px"
                            },
                            value: {
                                color: colors.bodyColor,
                                fontSize: "30px",
                                show: true
                            }
                        }
                    }
                },
                fill: {
                    opacity: 1
                },
                stroke: {
                    lineCap: "round",
                },
                labels: ["Project Data"]
            };

            var chart = new ApexCharts(document.querySelector("#internalStorageChart"), options);
            chart.render();
        }

        //External
        if ($('#externalStorageChart').length) {
            var totalProjects = @Html.Raw(Json.Encode(data.TotalExternalProjectCount));
            var completedProjects = @Html.Raw(Json.Encode(data.TotalExternalCompletedProject));
            var percentage = totalProjects > 0
                ? Math.round((completedProjects / totalProjects) * 100)
                : 0;
            var colors = {
                primary: '#029e9d', // Set the primary color to #029e9d
                light: '#f3f3f3',   // You can define other colors like light, muted, etc.
                muted: '#6c757d',
                bodyColor: '#212529'
            };
            var options = {
                chart: {
                    height: 260,
                    type: "radialBar",
                    events: {
                        // Listen for click event on the chart
                        click: function (event, chartContext, config) {
                            // Redirect based on the click event
                            window.location.href = "/accounts/ExternalProject";  // Change this to your desired URL
                        }
                    }
                },
                series: [percentage],
                colors: [colors.primary],
                plotOptions: {
                    radialBar: {
                        hollow: {
                            margin: 15,
                            size: "70%"
                        },
                        track: {
                            show: true,
                            background: colors.light,
                            strokeWidth: '100%',
                            opacity: 1,
                            margin: 5,
                        },
                        dataLabels: {
                            showOn: "always",
                            name: {
                                offsetY: -11,
                                show: true,
                                color: colors.muted,
                                fontSize: "13px"
                            },
                            value: {
                                color: colors.bodyColor,
                                fontSize: "30px",
                                show: true
                            }
                        }
                    }
                },
                fill: {
                    opacity: 1
                },
                stroke: {
                    lineCap: "round",
                },
                labels: ["Project Data"]
            };

            var chart = new ApexCharts(document.querySelector("#externalStorageChart"), options);
            chart.render();
            }
        });
</script>


