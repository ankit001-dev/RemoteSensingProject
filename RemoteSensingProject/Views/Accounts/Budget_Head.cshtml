
@{
    ViewBag.Title = "Budget_Head";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var data = ViewData["headlist"] as List<RemoteSensingProject.Models.Admin.main.BudgetHeadModel>;
}

<nav class="page-breadcrumb d-flex align-items-center justify-content-between">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">/Budget Head</li>
    </ol>
    <button class="btn btn-primary" id="addEmployeeBtn"><i class="link-icon" data-feather="plus"></i> Add Budget Head</button>
</nav>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-title">
            Budget Head List
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead style="background-color:blue !important;">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Budget Head</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (data != null)
                        {
                            int i = 1;
                            foreach (var item in data as List<RemoteSensingProject.Models.Admin.main.BudgetHeadModel>)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@item.BudgetHead</td>
                                    <td>
                                        <a href="#" data-title="Edit" class="editDesgination" data-head="@item.BudgetHead" data-id="@item.Id"> <i class="fa-solid fa-pen"></i></a> &nbsp; &nbsp;
                                        <a href="#" data-title="Delete" class="deleteDesgination" data-id="@item.Id"> <i class="fa-solid fa-trash text-danger"></i></a>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="addEmployeeCategory" tabindex="-1" aria-labelledby="addEmployeeCategory" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="btn-close float-end" data-bs-dismiss="modal" aria-label="Close"></button>

                <h5 class="modal-title" id="exampleModalLabel">Add <span id="modalTitle">Budget Head</span></h5>

            </div>
            <div class="modal-body">
                <form class="forms-sample" id="categoryForms">
                    <div class="form-group">
                        <label>
                            Name :
                        </label>
                        <input type="text" id="budgethead" class="form-control" name="name" autocomplete="off" />
                        <input type="hidden" name="id" id="budgetid" />
                    </div>
                    <div class="text-center pt-3">
                        <button type="submit" class="btn btn-primary py-1"><i class="link-icon" data-feather="plus"></i> Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script>
    $(document).ready(function () {
        $(".table").DataTable({
            columnDefs: [
                { width: "100px", targets: 0 }
            ]
        });

        $('#addEmployeeBtn').on('click', function () {
            $('#categoryForms')[0].reset();
            $('#addEmployeeCategory').modal('show');
        })

        $("#categoryForms").on("submit", function (e) {

            e.preventDefault();
                let data = $(this).serialize();
                $.ajax({
                    url: "/accounts/InsertBudgetHead",
                    type: "post",
                    data: data,
                    success: function (res) {
                        if (res.status) {
                            Swal.fire({
                                title: "Successfully !",
                                text: res.message,
                                icon: "success",
                                didClose: () => {
                                    location.reload();
                                }
                            })
                        } else {
                            Swal.fire({
                                title: "Sorry !",
                                text: res.message,
                                icon: "warning"
                            })
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: "Server issue !",
                            text: "Server is busy ! Please try after sometime.",
                            icon: "error",
                            didClose: () => {
                                location.reload();
                            }
                        })
                    }
                })
        })

        $(document).on("click", ".deleteDesgination", function () {
            let dataId = $(this).attr("data-id");
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/accounts/RemoveBudgetHead",
                        type: "delete",
                        data: { id: dataId },
                        success: function (res) {
                            if (res.status) {
                                Swal.fire({
                                    title: "Successfully !",
                                    text: "Selected head has been deleted successfuly !",
                                    icon: "success",
                                    didClose: () => {
                                        location.reload();
                                    }
                                })
                            }
                            else {
                                Swal.fire({
                                    title: "Sorry !",
                                    text: "Some issue occred while processing your request! Please try after sometime.",
                                    icon: "warning"
                                })
                            }
                        },
                        error: function () {
                            Swal.fire({
                                title: "Server busy !",
                                text: "Server is busy! Please try after sometime.",
                                icon: "error",
                                didClose: () => {
                                    location.reload();
                                }
                            });
                        }
                    })
                }
            });
        })

        $(".editDesgination").click(function () {
            const name = $(this).data("head");
            const id = $(this).data("id");
            $('#budgethead').val(name);
            $('#budgetid').val(id);
            $("#addEmployeeCategory").modal("show");
        })

        $("#categoryForms").validate({
            rules: {
                name: {
                    required: true
                }
            },
            messages: {
                name: {
                    required: "This field is required!"
                }
            },
            errorClass: "is-invalid",
            errorElement: "div",
            errorPlacement: function (error, element) {
                error.addClass("invalid-feedback");
                error.insertAfter(element);
            },
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).removeClass("is-invalid").addClass("is-valid");
            }
        });
    })
</script>

