
@{
    ViewBag.Title = "Monthly_ManPower_Allocation_Report";
    Layout = "~/Views/Shared/_prashasanLayout.cshtml";
    var divisionList = ViewData["DivisionList"] as List<RemoteSensingProject.Models.Admin.main.CommonResponse>;
    var reportdata = ViewData["reportdata"] as List<RemoteSensingProject.Models.ProjectManager.DivisionOutsourceReport>;
}
<div class="row align-items-center">
    <div class="col-lg-2">
        <h5>All Project</h5>
    </div>
    <div class="col-lg-4 col-md-6">
        <input type="text" placeholder="Search by project name" id="searchProjectBy" class="form-control">
    </div>
    <div class="col-lg-3 col-md-6">
        <select class="form-select form-select-lg" id="searchByDivision">
            <option selected value="">Filter by Division</option>
            @foreach (var item in divisionList)
            {
                <option value="@item.id">@item.name</option>
            }
        </select>
    </div>
    <div class="col-lg-3 col-md-6">
        <select class="form-select form-select-lg" id="searchByMonth">
            <option selected value="">Filter by Month</option>
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        </select>
    </div>
    <div class="col-lg-3 col-md-6">
        <input class="form-control" placeholder="Enter year...." id="filterByYear" />
    </div>

</div>

<div class="container my-4">
    <div class="card">
        <div class="card-body">

            <!-- Header -->
            <div class="row mb-3">
                <div class="col-md-8 fw-bold">
                    प्रभाग का नाम : @(reportdata !=null && reportdata.Count>0? reportdata[0].DivisionName:"")
                </div>
                <div class="col-md-4 text-end fw-bold">
                    माह : दिसम्बर, 2025
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="text-center fw-bold">
                        <tr>
                            <th style="width:80px">क्रम सं.</th>
                            <th>
                                परियोजना का नाम<br>
                                <small>(बाह्य सहायक / गैर वेतन मद)</small>
                            </th>
                            <th>परियोजना में आबद्ध मानवशक्ति का नाम</th>
                            <th>पदनाम</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int srNo = 1;

                            var groupedProjects = reportdata
                                .GroupBy(x => x.ProjectId)
                                .ToList();
                        }

                        @foreach (var project in groupedProjects)
                        {
                            bool firstRow = true;
                            int rowSpan = project.Count();

                            foreach (var item in project)
                            {
                                <tr>
                                    @if (firstRow)
                                    {
                                        <td class="text-center fw-bold" rowspan="@rowSpan">
                                            @srNo
                                        </td>
                                        <td rowspan="@rowSpan" class="fw-bold">
                                            @item.ProjectName
                                        </td>
                                    }

                                    <td>@item.OutsourceName</td>
                                    <td>@item.DesignationName</td>
                                </tr>

                                firstRow = false;
                            }

                            srNo++;
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>


<script>
    function loadReport() {
        let division = $("#searchByDivision").val();
        let month = $("#searchByMonth").val();
        let year = $("#filterByYear").val();

        if (division && month && year) {
            window.location.href =
                `/prashasan/Monthly_ManPower_Allocation_Report?divisionId=${division}&month=${month}&year=${year}`;
        }
    }

    $("#searchByDivision, #searchByMonth").change(loadReport);
    $("#filterByYear").on("blur", loadReport);

</script>