
@{
    ViewBag.Title = "Attendance_Report";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    var counts = ViewData["attendanceCount"] as List<RemoteSensingProject.Models.ProjectManager.AttendanceManage>;
    var data = ViewData["tourlist"] as List<RemoteSensingProject.Models.ProjectManager.tourProposal>;
    var financialyears = ViewData["financialyears"] as List<string>;
}


<nav class="page-breadcrumb mx-0 d-flex align-items-center justify-content-between">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item active" aria-current="page">View Attendance</li>
    </ol>
</nav>
<div class="row">
    <div class="col-md-12">
        <div class="card px-0">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-4">
                        <label>Select Financial Year</label>
                        <select class="form-select form-select-sm" id="financialyearfilter">
                            <option value="">Select Financial Year</option>
                            @if (financialyears != null && financialyears.Count > 0)
                            {
                                foreach (var fy in financialyears)
                                {
                                    <option value="@fy" @(ViewBag.SelectedFY == fy ? "selected" : "")>@fy</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card  px-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table-bordered table-striped" id="dataTableExample">
                        <thead>
                            <tr>
                                <th>Sr. No.</th>
                                <th>Project Name</th>
                                <th>Purpose</th>
                                <th>Place Visit</th>
                                <th>Period From</th>
                                <th>Period To</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (data != null)
                            {
                                int i = 1;
                                foreach (var item in data)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td><a title="View Detail" class="cursor-pointer viewTourDetails" data-id="@item.id">@item.projectName</a></td>
                                        <td>@item.purpose</td>
                                        <td>@item.place</td>
                                        <td>@item.periodFrom</td>
                                        <td>@item.periodTo</td>
                                        <td class="text-center"><a class="view-btn cursor-pointer" title="View Attendance" data-id="@item.id"><i class="fa-solid fa-clipboard-user"></i></a></td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Attendance List Modal -->
<div class="modal fade" id="ViewattendanceModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="margin-top:-1%">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h5 class="text-light">Attendance Sheet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <div class="row mb-2">
                    <div class="col-sm-4 col-md-4">
                        <select class="form-select form-select-sm" id="monthFilter">
                            <option value="">Select Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="staffdropdown">
                            <option value="">Filter by projectstaff</option>
                        </select>
                    </div>

                </div>

                <div class="table-responsive" style="font-size:12px;">
                    <table class="table table-bordered" id="">
                        <thead id="attendanceListDates">
                            <tr>
                                <th>Sr.No.</th>
                                <th>Project Staff</th>
                                <th>Location</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="attendancelist">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="tourdetailModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-100" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Tour Details </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tourDetailContainer">
                    <!-- Partial view will load here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentTourId = 0;
    let selectedMonth = "";
    let selectedStaff = "";
    function loadAttendance() {

        selectedMonth = $('#monthFilter').val();
        selectedStaff = $('#staffdropdown').val();

        $.ajax({
            url: '/employee/GetProjectStaffFromTour',
            type: 'get',
            data: {
                tourid: currentTourId,
                projectstaffid: selectedStaff,
                month: selectedMonth
            },
            success: function (res) {

                if (res.status) {

                    var staffdropdown = $("#staffdropdown");
                    staffdropdown.empty();
                    staffdropdown.append('<option value="">Filter by projectstaff</option>');

                    $.each(res.projectstafflist, function (index, item) {

                        let selected = item.Id == selectedStaff ? "selected" : "";

                        staffdropdown.append(
                            `<option value="${item.Id}" ${selected}>${item.EmpName}</option>`
                        );

                    });

                    var tbody = $("#attendancelist");
                    tbody.empty();

                    $.each(res.data, function (index, item) {

                        var row = `<tr>
                        <td>${index + 1}</td>
                        <td>${item.ProjectStaffName}</td>
                        <td>${item.Location}</td>
                        <td>${item.AttendanceDate}</td>
                        <td>${item.AttendanceStatus}</td>
                    </tr>`;

                        tbody.append(row);

                    });

                    $('#monthFilter').val(selectedMonth);

                }

            }
        });

    }

    //Show Attendance Data
    $(document).on("click", ".view-btn", function () {

        currentTourId = $(this).data("id");   // store tour id

        loadAttendance();                     // call function

        $("#ViewattendanceModal").modal("show");

    });

    $('#monthFilter').on('change', function () {
        loadAttendance();
    });

    $('#staffdropdown').on('change', function () {
        loadAttendance();
    });

    //Filters

    $('#financialyearfilter').on('change', function () {

        let fy = $(this).val();

        const url = new URL(window.location.href);

        if (fy) {
            url.searchParams.set("financialyear", fy);
        } else {
            url.searchParams.delete("financialyear");
        }

        window.location.href = url.toString();

    });

    $(document).ready(function () {

        const params = new URLSearchParams(window.location.search);
        const fy = params.get('financialyear');

        if (fy) {
            $('#financialyearfilter').val(fy);
        }

    });

    $(document).on("click", ".viewTourDetails", function () {

        let id = $(this).data("id");

        Swal.fire({
            title: "Please wait!",
            text: "Loading tour details...",
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });

        $.ajax({
            url: '/home/TourDetails',
            type: 'GET',
            data: { id: id },
            success: function (html) {

                $("#tourDetailContainer").html(html);
                $("#tourdetailModal").modal("show");
                Swal.close();
            },
            error: function () {
                Swal.fire("Error", "Unable to load tour details", "error");
            }
        });
    });
</script>