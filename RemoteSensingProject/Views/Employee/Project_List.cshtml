@{
    ViewBag.Title = "Project_List";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    int i = 1;
    var financialyears = ViewData["financialyears"] as List<string>;
}
<style>
    svg {
        height: 20px;
    }
</style>
<div class="search-box p-4 bg-white rounded mb-3 box-shadow">
    <div class="row align-items-center">
        <div class="col-lg-12 mb-2">
            <h5>Project Lists</h5>
        </div>
        <div class="col-lg-6 col-md-6">
            <input type="text" id="searchProjectBy" name="searchByProjectName" placeholder="Search by project name" class="form-control">
        </div>
        <div class="col-lg-3 col-md-6">
            <select id="filterProjectStatus" class="form-select form-select-lg">
                <option selected value="">Project Status</option>
                <option value="Ongoing">Ongoing</option>
                <option value="Upcoming">Upcoming</option>
                <option value="delay">Delay</option>
                <option value="Complete">Completed</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-3">
            <select class="form-select form-select-sm" id="financialyearfilter">
                <option value="">Select Financial Year</option>
                @if (financialyears != null && financialyears.Count > 0)
                {
                    foreach (var fy in financialyears)
                    {
                        <option value="@fy" @(ViewBag.SelectedFY == fy ? "selected" : "")>@fy</option>
                    }
                }
            </select>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <h6 class="card-title mb-0">Projects</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="dataTableExample">
                <thead>
                    <tr>
                        <th class="pt-0">Sr</th>
                        <th class="pt-0">Project Code</th>
                        <th class="pt-0">Project Name</th>
                        <th class="pt-0">Division</th>
                        <th class="pt-0">Assign Date</th>
                        <th class="pt-0">Start Date</th>
                        <th class="pt-0">Completion Date</th>
                        <th class="pt-0">Status</th>
                        <th class="pt-0 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ViewBag.ProjectList as List<RemoteSensingProject.Models.Admin.main.Project_model>)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.projectCode</td>
                            <td><a href="/home/Project_Details?id=@item.Id" data-title="View Details" data-Id="@item.Id">@item.ProjectTitle</a></td>
                            <td>@item.devisionName</td>
                            <td>@Convert.ToDateTime(item.AssignDate).ToString("dd MMM yyyy")</td>
                            <td>@Convert.ToDateTime(item.StartDate).ToString("dd MMM yyyy")</td>
                            <td>@Convert.ToDateTime(item.CompletionDate).ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.ProjectStatus)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (item.CompletionDate < DateTime.Now)
                                {
                                    <span class="badge bg-danger">Delay</span>
                                }
                                else if (item.StartDate < DateTime.Now)
                                {


                                    <span class="badge bg-warning">Work in Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Pending</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.EncryptedAction("Add_Project", "Employee", new {id=item.Id})">
                                    <i class="link-icon" data-feather="edit"></i>
                                </a>

                                <a class="cursor-pointer deleteProject" data-projectId="@item.Id">
                                    <i class="link-icon text-danger" data-feather="delete"></i>
                                </a>


                            </td>
                        </tr>
                        i++;
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<script>

    // Search by text
    $('#searchProjectBy').on('keyup', function () {
        let value = $(this).val().trim();
        const url = new URL(window.location.href);

        if (value) url.searchParams.set("searchTerm", value);
        else url.searchParams.delete("searchTerm");

        const division = $("#filterProjectStatus").val();
        if (division && division !== "null") url.searchParams.set("statusFilter", division);
        else url.searchParams.delete("statusFilter");

        const fy = $("#financialyearfilter").val();
        if (fy) url.searchParams.set("financialyear", fy);
        else url.searchParams.delete("financialyear");

        clearTimeout(window.searchTimer);
        window.searchTimer = setTimeout(() => {
            showLoader();
            window.location.href = url.toString();
        }, 500);
    });


    // Filter by status
    $("#filterProjectStatus").on("change", function () {
        const url = new URL(window.location.href);

        if ($(this).val()) url.searchParams.set("statusFilter", $(this).val());
        else url.searchParams.delete("statusFilter");

        const searchValue = $('#searchProjectBy').val().trim();
        if (searchValue) url.searchParams.set("searchTerm", searchValue);

        const fy = $("#financialyearfilter").val();
        if (fy) url.searchParams.set("financialyear", fy);

        showLoader();
        window.location.href = url.toString();
    });


    // Financial Year Filter
    $("#financialyearfilter").on("change", function () {

        const url = new URL(window.location.href);
        const fy = $(this).val();

        if (fy) url.searchParams.set("financialyear", fy);
        else url.searchParams.delete("financialyear");

        const searchValue = $('#searchProjectBy').val().trim();
        if (searchValue) url.searchParams.set("searchTerm", searchValue);

        const division = $("#filterProjectStatus").val();
        if (division) url.searchParams.set("statusFilter", division);

        showLoader();
        window.location.href = url.toString();
    });


    // Set values on page load
    $(document).ready(function () {

        const urlParams = new URLSearchParams(window.location.search);

        const search = urlParams.get('searchTerm');
        const division = urlParams.get('statusFilter');
        const fy = urlParams.get('financialyear');

        if (search) $('#searchProjectBy').val(search).focus();
        if (division) $('#filterProjectStatus').val(division);
        if (fy) $('#financialyearfilter').val(fy);

    });

    $(document).on("click", ".deleteProject", function () {

        let projectId = $(this).data("projectid"); // fixed line

        const swalWithBootstrapButtons = Swal.mixin({
            customClass: {
                confirmButton: "btn btn-success",
                cancelButton: "btn btn-danger"
            },
            buttonsStyling: false
        });
        swalWithBootstrapButtons.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "No, cancel!",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/api/DeleteProject",
                    type: "GET", // better in uppercase
                    data: { projectId: projectId },
                    success: function (res) {
                        Swal.fire({
                            title: res.status ? "Successfully!" : "Sorry!",
                            text: res.message,
                            icon: res.status ? "success" : "warning",
                            didClose: () => {
                                if (res.status) {
                                    location.reload();
                                }
                            }
                        });
                    },
                    error: function () {
                        Swal.fire({
                            title: "Server Error!",
                            text: "Some internal server issue found.",
                            icon: "error",
                            didClose: () => {
                                location.reload();
                            }
                        });
                    }
                });
            } else if (
                /* Read more about handling dismissals below */
                result.dismiss === Swal.DismissReason.cancel
            ) {
                swalWithBootstrapButtons.fire({
                    title: "Cancelled",
                    text: "Your imaginary file is safe :)",
                    icon: "error"
                });
            }
        });



    });
</script>




