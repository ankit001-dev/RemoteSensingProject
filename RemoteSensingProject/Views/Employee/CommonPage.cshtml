
@{
    ViewBag.Title = "CommonPage";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    var data = ViewData["dynamicformats"] as List<RemoteSensingProject.Models.ProjectManager.DynamicTableFormatsDto>;
}
<style>
    .dashboard-card {
        position: relative;
        height: 140px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(135deg,#eef2ff,#e0e7ff);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        transition: all .35s ease;
        overflow: hidden;
        font-size: 20px;
    }

        .dashboard-card h5 {
            font-weight: 600;
            color: #1e293b;
            letter-spacing: .5px;
            font-size: 24px;
            z-index: 2;
            max-width: 90%;
            /* ellipsis */
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* animated shapes */
        .dashboard-card::before,
        .dashboard-card::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            transition: all .4s ease;
        }

        .dashboard-card::before {
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.35);
            top: -80px;
            right: -80px;
        }

        .dashboard-card::after {
            width: 140px;
            height: 140px;
            background: rgba(255,255,255,0.25);
            bottom: -60px;
            left: -60px;
        }

        /* hover effect */
        .dashboard-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
            background: linear-gradient(135deg,#2563eb,#4f46e5);
        }

            .dashboard-card:hover h5 {
                color: #fff;
            }

            .dashboard-card:hover::before,
            .dashboard-card:hover::after {
                transform: scale(1.2);
            }
</style>

<div class="container mt-4">
    <div class="row g-4">

        <div class="col-lg-3 col-md-6">
            <a href="/employee/InternalProject_ProgressReport" class="text-decoration-none">
                <div class="dashboard-card">
                    <h5>Internal</h5>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="/employee/ExternalProject_ProgressReport" class="text-decoration-none">
                <div class="dashboard-card">
                    <h5>External</h5>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="/employee/ProjecStaffProgressReport" class="text-decoration-none">
                <div class="dashboard-card">
                    <h5>Project Staff</h5>
                </div>
            </a>
        </div>

        @if (data != null && data.Count > 0)
        {
            foreach (var item in data)
            {
                <div class="col-lg-3 col-md-6">
                    <a href="/employee/DynamicFormat?id=@item.TableId" class="text-decoration-none">
                        <div class="dashboard-card">
                            <h5 data-bs-toggle="tooltip" title="@item.FormatName">
                                @item.FormatName
                            </h5>
                        </div>
                    </a>
                </div>
            }
        }

    </div>
</div>

<script>
var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
})
</script>