
@{
    ViewBag.Title = "Add_Project";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    var budgetHeads = ViewData["BudgetHeads"] as List<RemoteSensingProject.Models.Admin.main.BudgetHeadModel>;
    var designations = ViewData["Designations"] as List<RemoteSensingProject.Models.Admin.main.CommonResponse>;
}


<style>
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #444;
        line-height: 13px;
    }
</style>

<nav class="page-breadcrumb d-flex align-items-center justify-content-between">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item active" id="pageTitle" aria-current="page">Add Project</li>
    </ol>
    <a href="/employee/Project_List" class="btn btn-primary"><i class="link-icon" data-feather="arrow-left"></i> Back To List</a>
</nav>
<div class="row mx-0">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <form class="forms-sample" id="createProjectForm">
                    <input type="hidden" name="pm.pm.ProjectId" id="ProjectId" value="0" />
                    <div class="row">
                        <div class="col-lg-4 mb-3">
                            <label for="upload" class="form-label">Title</label>
                            <input type="text" name="pm.pm.ProjectTitle" class="form-control form-control-sm" id="daynight" placeholder="Enter Project Title">
                        </div>
                        <div class="col-lg-4 mb-3">
                            <label for="title" class="form-label">Assign Date</label>
                            <div>
                                <input type="date" class="form-control form-control-sm" name="pm.pm.AssignDate" id="assignDate" required>
                            </div>
                        </div>
                        <div class="col-lg-4 mb-3">
                            <label for="subtitle" class="form-label">Start Date (Fund Recieved Date)</label>
                            <div>
                                <input type="date" class="form-control form-control-sm" name="pm.pm.StartDate" id="startDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-4 mb-3">
                            <label for="title" class="form-label">Completion Date</label>
                            <div>
                                <input type="date" class="form-control form-control-sm" name="pm.pm.CompletionDate" id="completionDate" required>
                            </div>
                        </div>
                        <div class="col-lg-4 mb-3">
                            <div class="d-flex justify-content-between">
                                <label for="title" class="form-label">Budget (in Lacs.)</label><label class="form-label" id="addBudgetItem" data-count="1"> <a href="#"><i class="fa-solid fa-circle-plus"></i> Add Budget Heads</a></label>
                            </div>
                            <input type="text" class="form-control form-control-sm" name="pm.pm.ProjectBudget" id="budgetAmount" placeholder="Enter Project Budget" required>
                        </div>
                        <div class="col-lg-4 mb-3">
                            <div class="d-flex justify-content-between">
                                <label for="humanResourcesCount" class="form-label">Project Staff</label><label class="form-label" id="addHRItem" data-count="1"> <a href="#"><i class="fa-solid fa-circle-plus"></i> Add Project Staff</a></label>
                            </div>
                            <input type="number" class="form-control form-control-sm" name="pm.pm.hrCount" id="humanResourcesCount" placeholder="Enter total HR count" required min="0">
                        </div>

                    </div>
                    <div class="row">

                        <div class="col-lg-4 mb-3">
                            <label for="title" class="form-label">Project Document</label>
                            <input type="file" class="form-control form-control-sm" name="" id="projectDocumentFile">
                        </div>


                        <div class="col-lg-4 mb-3">
                            <label for="title" class="form-label">Project Type</label>
                            <br />
                            <label for="projectType" class="form-label">
                                <input type="radio" name="pm.pm.ProjectType" class="form-check-input" value="Internal" checked required /><span style="font-size: small !important;">Internal (Non Salary Head from Government of U.P.)</span>
                            </label>
                            <label for="stage" class="form-label">
                                <input type="radio" name="pm.pm.ProjectType" class="form-check-input" value="External" required /><span style="font-size: small !important;">Externally Funded Project</span>
                            </label>
                        </div>


                        <div class="col-lg-4 mb-3">
                            <label for="title" class="form-label w-100">Stage</label>
                            <label for="stage" class="form-label">
                                <input type="radio" name="pm.pm.ProjectStage" class="form-check-input" value="true" required /> <span>Yes</span>
                            </label>
                            <label for="stage" class="form-label ms-2">
                                <input type="radio" name="pm.pm.ProjectStage" class="form-check-input" value="false" checked required /><span>No</span>
                            </label>


                        </div>
                    </div>
                    <div id="budgetContainerBox" style="display:none;">
                        <fieldset>
                            <legend style="font-size:15px;"> <label class="form-label my-2 fw-bolder"><a href="#">Project Budget Detail</a></label></legend>

                            <div class="row" id="budgetRows"></div>
                        </fieldset>
                    </div>
                    <div class="col-lg-12 mb-3" id="humanResourcesContainer" style="display:none;">
                        <fieldset>
                            <legend style="font-size:15px;">
                                <label class="form-label my-2 fw-bolder">
                                    <a href="#">
                                        Project Staff Details
                                    </a>
                                </label>
                            </legend>
                            <div id="hrRows"></div>
                        </fieldset>
                    </div>
                    <div id="projectTypeDetailContainer" style="display:none;">
                        <fieldset>
                            <legend style="font-size:15px;">  <label class="form-label my-2 fw-bolder"><a href="#">External Project Detail</a></label></legend>


                            <div class="row stageListItem">
                                <div class="col-lg-4 mb-3">
                                    <label for="title" class="form-label">Department Name</label>
                                    <input type="text" class="form-control form-control-sm" id="venue" name="pm.pm.ProjectDepartment" placeholder="Enter Key Point">
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label for="title" class="form-label">Contact Person</label>
                                    <input type="text" class="form-control form-control-sm" id="person" name="pm.pm.ContactPerson" placeholder="Enter Contact Person Name">
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label for="title" class="form-label">Address</label>
                                    <input type="text" class="form-control form-control-sm" id="person" name="pm.pm.Address" placeholder="Enter address">
                                </div>

                            </div>
                        </fieldset>
                    </div>
                    <div id="stageItemContainer" style="display:none;">
                        <fieldset>
                            <legend style="font-size:15px;">
                                <div class="d-flex justify-content-between">
                                    <label class="form-label my-2 fw-bolder"><a href="#">Project Stage Detail</a></label>
                                    <label class="form-label" id="addStageIcon" data-count="0 "> <a href="#"><i class="link-icon" data-feather="plus"></i> Add Stage</a> <sup style="font-size:10px; color:red;">(* Max 10 stage allowed)</sup></label>
                                </div>
                            </legend>

                        </fieldset>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 mb-3">
                            <label for="description" class="form-label"> Description</label>
                            <textarea class="form-control form-control-sm" name="pm.pm.ProjectDescription" id="tinymceExample" rows="10" placeholder="Project Description" required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
$(function () {

    /* ==========================================================
       🔹 GLOBAL DATA CACHE
    ========================================================== */

    const designations = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(designations));
    const allBudgetHeads = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(budgetHeads));
    const projectId = parseInt(@ViewBag.projectId) || 0;
    const $form = $("#createProjectForm");
    const $hrRows = $("#hrRows");
    const $budgetRows = $("#budgetRows");
    const $stageContainer = $("#stageItemContainer");

    /* ==========================================================
       🔹 COMMON UTILITIES
    ========================================================== */

    function initSelect2(context = document) {
        $(context).find("select").each(function () {
            const $el = $(this);
            if ($el.hasClass("select2-hidden-accessible")) {
                $el.select2("destroy");
            }
            $el.select2({ width: "100%" });
        });
    }

    function convertToInputDate(dateStr) {
        if (!dateStr) return "";
        const parts = dateStr.split("-");
        if (parts.length !== 3) return "";
        return `${parts[2]}-${parts[1]}-${parts[0]}`;
    }

    initSelect2();

    /* ==========================================================
       🔹 HUMAN RESOURCE SECTION
    ========================================================== */

    function generateHRRow(hr = null) {

        return `
<div class="row hrRow mb-2 align-items-center">
    <div class="col-lg-4">
    <label>Project Staff Designation</label>
        <select class="form-control form-control-sm hr-designation-select">
            <option value="">Select Designation</option>
            ${designations.map(d => `<option value="${d.id}" ${hr?.designationId == d.id ? "selected" : ""}>${d.name}</option>`)
                .join('')}
        </select>
    </div>
    
    <div class="col-lg-3">
    <label>Existing Project Staff</label>
        <input type="number" class="form-control form-control-sm hr-count"
    value="${hr?.designationCount ?? 0}" min="0">
    </div>
    <div class="col-lg-3">
<label>Project Staff Requirement</label>
    <input type="number"
           class="form-control form-control-sm hr-requirement"
           placeholder="Enter Project Staff Requirement" value="${hr?.designationRequirement ?? 0}"
           min="0">
</div>
    <div class="col-lg-2 text-center">
        <a href="#" class="deleteHRRow">
            <i class="fa-solid fa-trash text-danger fs-4"></i>
        </a>
    </div>
</div>`;
    }

    function updateOtherCount() {
        let totalHR = parseInt($("#humanResourcesCount").val()) || 0;
        let sum = 0;

        $hrRows.find(".hrRow").each(function () {
            if (!$(this).find(".hr-designation-id").length) {
                sum += parseInt($(this).find(".hr-count").val()) || 0;
                sum += parseInt($(this).find(".hr-requirement").val()) || 0;
            }
        });

        if (sum > totalHR) {
            Swal.fire("Warning!", "Total count cannot exceed Project Staff count.", "warning");
            $(this).val(0);
            let remaining = Math.max(totalHR - sum, 0);
            $hrRows.find(".hr-designation-id").each(function () {
                $(this).closest(".hrRow").find(".hr-count").val(remaining);
            });
        }
       

        
    }

    $("#addHRItem").click(function () {
        let totalHR = parseInt($("#humanResourcesCount").val());
        if (!totalHR || totalHR <= 0) {
            Swal.fire("Warning!", "Enter valid HR count.", "warning");
            return;
        }

        $("#humanResourcesContainer").show();
        $hrRows.append(generateHRRow());
        initSelect2($hrRows);
    });

    $hrRows.on("click", ".deleteHRRow", function (e) {
        e.preventDefault();
        $(this).closest(".hrRow").remove();
        updateOtherCount();
    });

    $hrRows.on("input", ".hr-count, .hr-requirement", updateOtherCount);

    /* ==========================================================
       🔹 BUDGET SECTION
    ========================================================== */

    function refreshBudgetDropdowns() {

        const selected = $(".budget-head-select").map(function () {
            return $(this).val();
        }).get();

        $(".budget-head-select").each(function () {
            let currentVal = $(this).val();
            $(this).empty().append(`<option value="">Select Budget Head</option>`);

            allBudgetHeads.forEach(h => {
                if (!selected.includes(h.Id.toString()) || h.Id.toString() === currentVal) {
                    $(this).append(`<option value="${h.Id}">${h.BudgetHead}</option>`);
                }
            });

            $(this).val(currentVal);
        });
    }

    $("#addBudgetItem").click(function (e) {
        e.preventDefault();

        let budgetVal = parseFloat($("#budgetAmount").val());
        if (!budgetVal || budgetVal <= 0) {
            Swal.fire("Warning!", "Enter Project Budget first.", "warning");
            return;
        }

        let index = $(".budgetRow").length;

        let row = `
        <div class="row budgetRow mb-2">
            <input type="hidden" name="pm.budgets[${index}].Id" value="0" />

            <div class="col-lg-5">
                <select class="form-select form-select-sm budget-head-select"
                    name="pm.budgets[${index}].HeadId">
                    <option value="">Select Budget Head</option>
                    ${allBudgetHeads.map(h =>
                        `<option value="${h.Id}">${h.BudgetHead}</option>`
                    ).join("")}
                </select>
            </div>

            <div class="col-lg-5">
                <input type="text" class="form-control form-control-sm amnt"
                    name="pm.budgets[${index}].ProjectAmount">
            </div>

            <div class="col-lg-2 text-center">
                <a href="#" class="deleteBudgetRow">
                    <i class="fa-solid fa-trash text-danger fs-4"></i>
                </a>
            </div>
        </div>`;

        $("#budgetContainerBox").show();
        $budgetRows.append(row);
        initSelect2($budgetRows);
    });

    $budgetRows.on("click", ".deleteBudgetRow", function (e) {
        e.preventDefault();
        $(this).closest(".budgetRow").remove();
        refreshBudgetDropdowns();
    });

    $budgetRows.on("change", ".budget-head-select", function () {
        const selectedValue = $(this).val();
        if (!selectedValue) return;

        let duplicate = false;

        $(".budget-head-select").not(this).each(function () {
            if ($(this).val() === selectedValue) {
                duplicate = true;
                return false;
            }
        });

        if (duplicate) {
            Swal.fire("Error!", "This Budget Head is already selected.", "error");
            $(this).val("").trigger("change");
        }
    });

    $budgetRows.on("input", ".amnt", function () {
        let total = 0;
        $(".amnt").each(function () {
            total += parseFloat($(this).val()) || 0;
        });

        let budget = parseFloat($("#budgetAmount").val()) || 0;

        if (total > budget) {
            Swal.fire("Error!", "Total exceeds Project Budget.", "error");
            $(this).val("");
        }
    });

    /* ==========================================================
       🔹 STAGE SECTION
    ========================================================== */
    $("input[name='pm.pm.ProjectStage']").on("change", function () {

        const isStage = $(this).val() == "true";

        if (isStage) {

            $("#stageItemContainer").show();
            $("#addStageIcon").show();

            // If no stage exists yet, add first automatically
            if ($stageContainer.find(".stageListItem").length === 0) {
                $("#addStageIcon").trigger("click");
            }

        } else {

            $("#stageItemContainer").hide();
            $("#addStageIcon").hide();
            $stageContainer.find(".stageListItem").remove();
            $("#addStageIcon").attr("data-count", 0);

        }

    });
    $("#addStageIcon").click(function (e) {
        e.preventDefault();

        let count = parseInt($(this).attr("data-count")) || 0;
        
        if (count >= 10) return;

        let row = `
        <div class="row stageListItem">
            <input type="hidden" name="pm.stages[${count}].Id" value="0"/>
            <div class="col-lg-4 mb-3">
                <input type="text" class="form-control form-control-sm"
                    name="pm.stages[${count}].KeyPoint" required>
            </div>
            <div class="col-lg-4 mb-3">
                <input type="file" class="form-control form-control-sm"
                    name="pm.stages[${count}].Stage_Document">
            </div>
            <div class="col-lg-3 mb-3">
                <input type="date" class="form-control form-control-sm"
                    name="pm.stages[${count}].CompletionDate" required>
            </div>
            <div class="col-lg-1 text-center">
                <a href="#" class="deleteStageRow">
                    <i class="fa-solid fa-trash text-danger fs-4"></i>
                </a>
            </div>
        </div>`;

        $stageContainer.append(row);
        $(this).attr("data-count", count + 1);
    });

    $stageContainer.on("click", ".deleteStageRow", function (e) {
        e.preventDefault();
        let i = $("#stageItemContainer #addStageIcon").attr("data-count");
        if (i > 0)
            i--;
        $("#stageItemContainer #addStageIcon").attr("data-count", i); 
        $(this).closest(".stageListItem").remove();
    });
    /* ==========================================================
   🔹 PROJECT TYPE SELECTION
========================================================== */
    $("input[name='pm.pm.ProjectType']").on("change", function () {
        if ($(this).val() === "External") {
            $("#projectTypeDetailContainer").show();
        } else {
            $("#projectTypeDetailContainer").hide();
        }
    });
    /* ==========================================================
       🔹 UPDATE MODE (GET BY ID)
    ========================================================== */

    function bindProjectData(data) {

        const pm = data.pm;

        $("#ProjectId").val(pm.Id);
        $("input[name='pm.pm.ProjectTitle']").val(pm.ProjectTitle);
        $("input[name='pm.pm.ProjectBudget']").val(pm.ProjectBudget);
        $("input[name='pm.pm.ProjectDepartment']").val(pm.ProjectDepartment);
        $("input[name='pm.pm.ContactPerson']").val(pm.ContactPerson);
        $("input[name='pm.pm.Address']").val(pm.Address);
        $("input[name='pm.pm.hrCount']").val(pm.hrCount);
        $("textarea[name='pm.pm.ProjectDescription']").val(pm.ProjectDescription);

        $("input[name='pm.pm.AssignDate']").val(convertToInputDate(pm.AssignDateString));
        $("input[name='pm.pm.StartDate']").val(convertToInputDate(pm.StartDateString));
        $("input[name='pm.pm.CompletionDate']").val(convertToInputDate(pm.CompletionDatestring));

        $("input[name='pm.pm.ProjectType'][value='" + pm.ProjectType + "']").prop("checked", true);
        $("input[name='pm.pm.ProjectStage'][value='" + pm.ProjectStage + "']").prop("checked", true);

        if (pm.ProjectType === "External") {
            $("#projectTypeDetailContainer").show();
        }

        if (pm.ProjectStage === true) {
            $("#stageItemContainer").show();
        }
    }

    function bindHumanResources(data) {
        if (!data.hr || data.hr.length === 0) return;
        $("#humanResourcesContainer").show();
        $hrRows.empty();
        data.hr.forEach(hr => $hrRows.append(generateHRRow(hr)));
        initSelect2($hrRows);
    }

    function bindBudgets(data) {
        if (!data.budgets || data.budgets.length === 0) return;

        $("#budgetContainerBox").show();
        $budgetRows.empty();

        data.budgets.forEach((b, index) => {

            let row = `
            <div class="row budgetRow mb-2">
                <input type="hidden" name="pm.budgets[${index}].Id" value="${b.Id}" />

                <div class="col-lg-5">
                    <select class="form-select form-select-sm budget-head-select"
                        name="pm.budgets[${index}].HeadId">
                        ${allBudgetHeads.map(h =>
                            `<option value="${h.Id}"
                                ${h.Id == b.HeadId ? "selected" : ""}>
                                ${h.BudgetHead}
                            </option>`
                        ).join("")}
                    </select>
                </div>

                <div class="col-lg-5">
                    <input type="number" class="form-control form-control-sm amnt"
                        name="pm.budgets[${index}].ProjectAmount"
                        value="${b.ProjectAmount}">
                </div>

                <div class="col-lg-2 text-center">
                    <a href="#" class="deleteBudgetRow">
                        <i class="fa-solid fa-trash text-danger fs-4"></i>
                    </a>
                </div>
            </div>`;

            $budgetRows.append(row);
        });

        initSelect2($budgetRows);
    }

    function bindStages(data) {
        if (!data.stages || data.stages.length === 0) return;

        $("#stageItemContainer").show();
        $stageContainer.find(".stageListItem").remove();

        data.stages.forEach((stage, index) => {

            let row = `
            <div class="row stageListItem">
                <input type="hidden" name="pm.stages[${index}].Id" value="${stage.Id}" />

                <div class="col-lg-4 mb-3">
                    <input type="text" class="form-control form-control-sm"
                        name="pm.stages[${index}].KeyPoint"
                        value="${stage.KeyPoint}">
                </div>

                <div class="col-lg-4 mb-3">
                    <input type="file"
                        class="form-control form-control-sm"
                        name="pm.stages[${index}].Stage_Document">
                </div>

                <div class="col-lg-3 mb-3">
                    <input type="date"
                        class="form-control form-control-sm"
                        name="pm.stages[${index}].CompletionDate"
                        value="${convertToInputDate(stage.CompletionDatestring)}">
                </div>

                <div class="col-lg-1 text-center">
                    <a href="#" class="deleteStageRow">
                        <i class="fa-solid fa-trash text-danger fs-4"></i>
                    </a>
                </div>
            </div>`;

            $stageContainer.append(row);
        });

        $("#addStageIcon").attr("data-count", data.stages.length);
    }

   

    if (projectId) {

        $.ajax({
            url: "@Url.EncryptedAction("GetProjecDatatById", "Employee", new {Id = ViewBag.projectId })",
            type: "GET",
            success: function (res) {
                if (!res.status) return;

                const data = res.data;

                bindProjectData(data);
                bindHumanResources(data);
                bindBudgets(data);
                bindStages(data);

                $("#pageTitle").text("Update Project");
                $form.find("button[type='submit']").text("Update");
            }
        });
    }


    /* ==========================================================
   🔹 FORM SUBMIT (CREATE + UPDATE)
========================================================== */

    $form.on("submit", function (e) {

        e.preventDefault();

        if (!$form.valid()) return;

        let formData = new FormData(this);

        /* ===============================
           🔹 Project Document
        =============================== */
        const projFile = $("#projectDocumentFile")[0].files[0];
        if (projFile) {
            formData.append("pm.pm.projectDocument", projFile);
        }

        /* ===============================
           🔹 STAGE DOCUMENTS
        =============================== */
        $stageContainer.find(".stageListItem").each(function (index) {

            const fileInput = $(this).find("input[type='file']")[0];
            if (fileInput && fileInput.files.length > 0) {
                formData.append(`pm.stages[${index}].Stage_Document`, fileInput.files[0]);
            }

        });

        /* ===============================
           🔹 HUMAN RESOURCES
        =============================== */

        let hrIndex = 0;

        $hrRows.find(".hrRow").each(function () {

            const hrId = $(this).find(".hr-id").val() || 0;

            let designationId = "";

            if ($(this).find(".hr-designation-select").length) {
                designationId = $(this).find(".hr-designation-select").val();
            } else {
                designationId = $(this).find(".hr-designation-id").val();
            }

            const count = $(this).find(".hr-count").val();
            const requirement = $(this).find(".hr-requirement").val();

            if (!designationId || !count || count == 0) return;

            formData.append(`pm.hr[${hrIndex}].Id`, hrId);
            formData.append(`pm.hr[${hrIndex}].designationId`, designationId);
            formData.append(`pm.hr[${hrIndex}].designationCount`, count);
            formData.append(`pm.hr[${hrIndex}].designationRequirement`, requirement);

            hrIndex++;

        });

        /* ===============================
           🔹 BUDGETS
        =============================== */

        let budgetIndex = 0;

        $budgetRows.find(".budgetRow").each(function () {

            const id = $(this).find("input[name$='.Id']").val() || 0;
            const headId = $(this).find(".budget-head-select").val();
            const amount = $(this).find(".amnt").val();

            if (!headId || !amount) return;

            formData.append(`pm.budgets[${budgetIndex}].Id`, id);
            formData.append(`pm.budgets[${budgetIndex}].HeadId`, headId);
            formData.append(`pm.budgets[${budgetIndex}].ProjectAmount`, amount);

            budgetIndex++;

        });

        /* ===============================
           🔹 PROJECT ID (UPDATE MODE)
        =============================== */

        formData.append("pm.pm.Id", $("#ProjectId").val());

        /* ===============================
           🔹 AJAX CALL
        =============================== */

        $.ajax({
            url: "/Employee/InsertProject",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {

                if (res.status) {
                    Swal.fire("Success!", res.message, "success")
                        .then(() => location.reload());
                } else {
                    Swal.fire("Error!", res.message || "Something went wrong!", "error");
                }

            },
            error: function () {
                Swal.fire("Error!", "Server error occurred.", "error");
            }
        });

    });


});
