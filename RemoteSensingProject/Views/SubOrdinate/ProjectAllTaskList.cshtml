
@{
    ViewBag.Title = "ProjectAllTaskList";
    Layout = "~/Views/Shared/_subOrdinateLayout.cshtml";
    var data = ViewData["TaskList"] as List<RemoteSensingProject.Models.SubOrdinate.main.OutSource_Task>;
    var financialyears = ViewData["financialyears"] as List<string>;
}

<style>
    .link-icon {
        height: 16px;
    }
</style>
<div class="search-box p-4 bg-white rounded mb-3 box-shadow">
    <form class="forms-sample">
        <div class="row align-items-center">
            <div class="col-lg-3">
                <h5>All Tasks Lists</h5>
            </div>
            <div class="col-lg-4">
                <select class="form-select form-select-sm" id="financialyearfilter">
                    <option value="">Select Financial Year</option>
                    @if (financialyears != null && financialyears.Count > 0)
                    {
                        foreach (var fy in financialyears)
                        {
                            <option value="@fy" @(ViewBag.SelectedFY == fy ? "selected" : "")>@fy</option>
                        }
                    }
                </select>
            </div>
        </div>
    </form>
</div>
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="projectTable1" class="dataTableExample" style="width:100%">
                        <thead>
                            <tr>
                                <th>Sr No.</th>
                                <th>Project Name</th>
                                <th>Task</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                           @if(data != null && data.Count > 0)
            {
                               int i = 1;
                foreach(var item in data)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.projectName</td>
                        <td><a class="cursor-pointer viewTaskDetail" data-description="@item.Description">@item.Title</a></td>
                        <td> @if (!item.CompleteStatus) {


<span class="badge bg-primary">Pending</span>
}
else
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                        </td>
                    </tr>
                                   i++;
                               }
                           }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="modal fade" id="viewProjectModal" tabindex="-1" aria-labelledby="viewProjectModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header d-flex">
                        <h1 class="modal-title fs-5 text-success" id="exampleModalLabel"> Detail</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" id="viewProjectModalBody">

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    $(document).on("click", ".viewTaskDetail", function () {
        const description = $(this).data('description');

        Swal.fire({
            title: '<strong>Task Details</strong>',
            html: `<div style="max-height:250px; overflow-y:auto; text-align:left;">
            ${description || 'No description available.'}
           </div>`,
            icon: 'info',
            confirmButtonText: 'Close',
            confirmButtonColor: '#3085d6',
            width: '500px',
            padding: '1.5em',
            backdrop: `
        rgba(0,0,0,0.6)
    `,
            customClass: {
                popup: 'rounded-3 shadow-lg'
            }
        });
    });

    // Financial Year Filter
    $(document).ready(function () {
        // Financial Year Filter
        $("#financialyearfilter").on("change", function () {

            const url = new URL(window.location.href);
            const fy = $(this).val();

            if (fy) url.searchParams.set("financialyear", fy);
            else url.searchParams.delete("financialyear");

            window.location.href = url.toString();
        });
    })


    // Restore FY on page load
    $(document).ready(function () {

        const params = new URLSearchParams(window.location.search);
        const fy = params.get("financialyear");

        if (fy) {
            $("#financialyearfilter").val(fy);
        }

    });
</script>