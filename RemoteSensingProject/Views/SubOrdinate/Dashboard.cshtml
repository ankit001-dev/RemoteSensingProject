
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_subOrdinateLayout.cshtml";
    var data = Model as RemoteSensingProject.Models.SubOrdinate.main.DashboardCount;
}

<div class="row mx-0">
    <div class="col-12 col-xl-12">
        <div class="row flex-grow-1">
            <!-- Total Task Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/subordinate/projectalltasklist">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0 text-nowrap">Total Task's</h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-8">
                                        <p class="fs-2 fw-bold pt-3 text-dark ps-5">@data.TotalTaskCount</p>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-4">
                                        <img src="~/assets/gif/project.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Task Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/subordinate/projectpendingtasklist">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0 text-nowrap">Pending Task's</h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-8">
                                        <p class="fs-2 fw-bold pt-3 text-dark ps-5">@data.PendingTaskCount</p>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-4">
                                        <img src="~/assets/gif/file.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Complete Task Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/subordinate/projectcompletetasklist">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0 text-nowrap">Complete Task's</h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-8">
                                        <p class="fs-2 fw-bold pt-3 text-dark ps-5">@data.CompleteTaskCount</p>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-4">
                                        <img src="~/assets/gif/rfp.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Meeting Card -->
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-3 grid-margin stretch-card px-1">
                <div class="w-100" style="text-decoration: none; color: inherit;">
                    <div class="card uniform-card w-100 shadow-lg">
                        <div class="card-body">
                            <a href="/subordinate/meeting_list">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="card-title mb-0 text-nowrap">Total Meeting's</h6>
                                </div>
                                <div class="row">
                                    <div class="col-6 col-md-12 col-xl-8">
                                        <p class="fs-2 fw-bold pt-3 text-dark ps-5">@data.MeetingCount</p>
                                    </div>
                                    <div class="col-6 col-md-12 col-xl-4">
                                        <img src="~/assets/gif/discussion.gif" height="60" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="row mx-0">
    <div class="col-lg-12 col-xl-12 px-1">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <h6 class="card-title mb-0">Task Chart</h6>
                </div>
                <p class="text-muted">Check the current tasks dashboard for detailed updates.</p>
                <div id="taskchart"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    $(document).ready(function () {

        if ($('#taskchart').length) {

            // Razor se direct data lena
            var categories = ['Total Tasks', 'Pending Tasks', 'Completed Tasks'];

            var data = [
                @data.TotalTaskCount,
                @data.PendingTaskCount,
                @data.CompleteTaskCount
            ];

            var options = {
                chart: {
                    type: 'bar',
                    height: '318',
                    toolbar: { show: false }
                },
                colors: ['#1aa7a6'],
                series: [{
                    name: 'Count',
                    data: data
                }],
                xaxis: {
                    categories: categories
                },
                yaxis: {

                    title: {
                        text: 'Count'
                    }
                },
                dataLabels: {
                    enabled: true
                },
                plotOptions: {
                    bar: {
                        columnWidth: "50%",
                        borderRadius: 4,
                        dataLabels: {
                            position: 'top'
                        }
                    }
                }
            };

            var chart = new ApexCharts(document.querySelector("#taskchart"), options);
            chart.render();
        }

    });
</script>


