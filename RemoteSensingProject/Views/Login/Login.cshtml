@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Logistics Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ✅ REQUIRED FOR ICONS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">



    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #dfe5ec 0%, #cfd8e3 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        /* Main Card */
        .main-card {
            width: 1080px;
            min-height: 520px;
            background-color: #ffffff;
            border-radius: 14px;
            box-shadow: 0 18px 38px rgba(0, 33, 71, 0.12);
            overflow: hidden;
            display: flex;
        }

            .main-card .row {
                height: 100%;
            }

        /* Illustration */
        .bg-illustration {
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden;
        }

            .bg-illustration img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        /* Form Side */
        .form-side {
            padding: 28px 32px !important;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Headings */
        h5 {
            letter-spacing: 0.4px;
            color: #002147;
        }

        .Content-Form {
            font-size: 15px;
            color: #4b5563;
            line-height: 1.3;
        }

        /* Logo */
        .brand-logo {
            height: 4rem;
            width: auto;
            object-fit: contain;
        }

        /* Inputs */
        .form-label {
            margin-bottom: 4px;
        }

        .form-control {
            background-color: #f6f8fb !important;
            border: 1px solid #e2e6ec !important;
            padding: 10px 14px;
            font-size: 0.88rem;
            border-radius: 8px;
        }

            .form-control:focus {
                background-color: #ffffff !important;
                border-color: #002147 !important;
                box-shadow: 0 0 0 3px rgba(0, 33, 71, 0.12) !important;
            }

        /* Input group icons */
        .input-group-text {
            background-color: #f6f8fb;
            border: 1px solid #e2e6ec;
            color: #002147;
        }

        /* Checkbox */
        .form-check-input:checked {
            background-color: #002147;
            border-color: #002147;
        }

        /* Button */
        .btn-primary {
            background-color: #002147;
            border: none;
            padding: 11px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.25s ease;
        }

            .btn-primary:hover {
                background-color: #013064;
                transform: translateY(-1px);
                box-shadow: 0 6px 14px rgba(0, 33, 71, 0.25);
            }

        /* Links */
        a.text-primary {
            color: #002147 !important;
        }

            a.text-primary:hover {
                text-decoration: underline;
            }

        /* Muted text */
        .text-muted,
        .text-muted-small {
            color: #6b7280 !important;
            font-size: 0.85rem;
        }

        .logo-h6 {
            height: 4rem; /* h6 ke barabar */
            width: auto; /* aspect ratio safe */
            object-fit: contain;
        }


        /* Mobile */
        @@media (max-width: 768px) {
            .bg-illustration {
                display: none !important;
            }

            .form-side {
                width: 100% !important;
            }
        }
    </style>
</head>
<body>

    <div class="main-card shadow-lg">
        <div class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-md-5 bg-white form-side">
                    <div class="d-flex justify-content-between mb-4">
                        <div class="">
                            <img src="/assets/images/RemoteLogo.png"
                                 class="logo-h6"
                                 alt="RSAC Logo">
                        </div>
                        <div class="">
                            <p class="fw-bold"><span style="font-size: 21px;">Project Management System </span><br /> <span class="text-primary small mb-4" style="font-size: 12px;">Remote Sensing Applications Centre , Uttar Pradesh</span></p>

                        </div>
                    </div>
                    <div class="form-container">
                        <form id="login-form" method="post">

                            <!-- Email -->
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">User Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent">
                                        <i class="bi bi-envelope text-primary"></i>
                                    </span>
                                    <input type="text"
                                           id="username" name="username"
                                           class="form-control"
                                           placeholder="example@gmail.com"
                                           required>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent">
                                        <i class="bi bi-lock text-primary"></i>
                                    </span>
                                    <input type="password"
                                           class="form-control"
                                           id="password" name="password"
                                           placeholder="••••••••••••"
                                           required>
                                    <span class="input-group-text bg-transparent toggle-password"
                                          data-target="#password"
                                          style="cursor:pointer;">
                                        <i class="bi bi-eye"></i>
                                    </span>
                                </div>
                            </div>

                            <!-- Checkbox -->
                            <div class="form-check mb-4 text-end">
                                <a href="/login/ForgotPassword">Forget Password ?</a>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Login
                            </button>

                        </form>

                        <p class="mt-4 text-center small text-muted">
                            Developed by <a href="https://macreel.co.in/homepage" class="text-primary text-decoration-none fw-bold">Macreel Infosoft Pvt. Ltd.</a>
                        </p>
                        <p class="text-center text-muted fw-bold"> &copy; 2026 Remote Sensing Applications Centre , U.P.</p>
                    </div>
                </div>

                <div class="col-md-7 bg-illustration">
                    <img src="/loginAssets/images/newformimage.png" class="img-fluid" alt="Logistics Illustration" />
                </div>

            </div>
        </div>
    </div>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/assets/js/sweetalert.min.js"></script>
    <script>
        $("#login-form").on("submit", function () {


            if ($("#username").val().trim() == "" || $("#username").val().trim().indexOf("\"") > -1 || $("#username").val().trim().indexOf("'") > -1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Please Enter user name Correctly!',
                    footer: 'JetSet',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false,
                }).then((result) => {
                    $("#username").focus();
                });
                return false;
            }


            if ($("#password").val().trim() == "" || $("#password").val().trim().indexOf("\"") > -1 || $("#password").val().trim().indexOf("'") > -1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Please Enter Password Correctly!',
                    footer: 'JetSet',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    allowEnterKey: false,
                }).then((result) => {
                    $("#password").focus();
                });
                return false;
            }
            var formdata = $(this).serialize();
            Swal.fire({
                title: 'Please wait!',
                html: 'We are validating your details',
                timer: 200000000,
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false,
                didOpen: () => {
                    Swal.showLoading()
                },
                willClose: () => {
                    clearInterval(timerInterval)
                }
            });



            $.ajax({
                async: true,
                url: "/login/AuthoriseLogin",
                type: 'POST',
                data: formdata,
                success: function (data) {
                    debugger
                    if (data.status) {
                        window.location.href = data.url;
                        Swal.fire({
                            title: "Successfully !",
                            text: res.message,
                            icon: "success"
                        })
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            html: '<p style="font-size: 17px;">' + data.message + '</p>',
                            returnFocus: true,
                            returnFocus: false,
                        }).then((result) => {
                            if (result.isConfirmed) {
                                return false;
                            }
                        })
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    Swal.fire({
                        icon: 'error',
                        html: '<p style="font-size: 17px;">An Error Occured try again later or contact website administration.</p>',
                        returnFocus: true,
                        returnFocus: false,
                    }).then((result) => {
                        if (result.isConfirmed) {

                            return false;

                        }
                    })

                },
                complete: function () {
                }
            });

            return false;

        });
        document.querySelectorAll('.toggle-password').forEach(function (toggle) {
            toggle.addEventListener('click', function () {

                const target = document.querySelector(this.getAttribute('data-target'));
                const icon = this.querySelector('i');

                if (target.type === 'password') {
                    target.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    target.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>

</body>
</html>