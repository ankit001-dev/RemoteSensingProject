
@{
    ViewBag.Title = "DynamicFormat";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    var data = ViewData["data"] as RemoteSensingProject.Models.TechnicalCell.main.DynamicFormate;
    System.Data.DataTable dt = ViewData["DynamicData"] as System.Data.DataTable;
}

<style>
    .modal-body .sliderimages img {
        width: 20% !important;
        height: 20%;
        border-radius: 10px;
    }

    svg {
        height: 20px;
    }

    .custom-table {
        border: 2px solid #000;
    }

        .custom-table th,
        .custom-table td {
            border: 1px solid #000;
            font-size: 14px;
        }

        .custom-table thead th {
            background-color: #d9d9d9;
            font-weight: 600;
        }

    .small-text {
        font-size: 12px;
    }
</style>

<nav class="page-breadcrumb mb-3">
    <div class="container-fluid">
        <div class="row text-end">
            <div class="col-md-12">
                <button class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#addslider">
                    <i class="link-icon" data-feather="plus"></i>
                    Add
                </button>
            </div>
        </div>
    </div>
</nav>
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="text-center">
                    <h2 class="text-center mb-2">@data.FormatName</h2>
                </p>
                <div class="table-responsive">
                    <table class="table custom-table">

                        <thead>
                            <tr>
                                <th>Sr.No.</th>
                                @if (data != null && data.ColumnName != null)
                                {
                                    foreach (var col in data.ColumnName)
                                    {
                                        <th>@col</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (dt != null && dt.Rows.Count > 0)
                            {
                                int sr = 1;

                                foreach (System.Data.DataRow row in dt.Rows)
                                {
                                    <tr>
                                        <td>@sr</td>

                                        @foreach (var col in data.ColumnName)
                                        {
                                            <td>@row[col]</td>
                                        }

                                    </tr>

                                    sr++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(data.ColumnName.Count + 1)" class="text-center">
                                        No Data Available
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addslider" tabindex="-1" aria-labelledby="addslider" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title" id="exampleModalLabel">@data.FormatName</h5>
            </div>
            <div class="modal-body">
                <form class="forms-sample" id="AddFormatForm">

                    <div class="row">
                        <input type="hidden" id="tableName" value="@data.TableName" />
                        @if (data != null && data.ColumnName != null)
                        {
                            foreach (var col in data.ColumnName)
                            {
                                <div class="col-md-6 mb-2">
                                    <label class="form-label">@col</label>
                                    <input type="text" name="@col" placeholder="@col" class="form-control form-control-sm dynamic-field" />
                                </div>
                            }
                        }
                    </div>
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>


<script>

    $("#AddFormatForm").on("submit", function (e) {
        e.preventDefault();
        let tableName = $("#tableName").val();
        let formData = {};

        $(".dynamic-field").each(function () {

            let key = $(this).attr("name");
            let value = $(this).val();

            formData[key] = value;

        });

        $.ajax({
            url: '/employee/UpdateDynamicReportData',
            type: 'POST',
            data: {
                TableName: tableName,
                TableRawValue: JSON.stringify(formData)
            },
            success: function (res) {

                Swal.fire({
                    title: res.status ? "Successfully !" : "Sorry !",
                    text: res.message,
                    icon: res.status ? "success" : "warning",
                    didClose: () => {
                        if (res.status) {
                            location.reload();
                        }
                    }
                });

            },
            error: function () {

                Swal.fire({
                    title: "Server issue !",
                    text: "Internal server issue. Please try after sometime.",
                    icon: "error",
                    didClose: () => {
                        location.reload();
                    }
                });

            }

        });

    });

</script>