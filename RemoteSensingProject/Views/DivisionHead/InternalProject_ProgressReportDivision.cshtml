
@{
    ViewBag.Title = "InternalProject_ProgressReportDivision";
    Layout = "~/Views/Shared/_employeeLayout.cshtml";
    var projects = ViewData["projectList"] as List<RemoteSensingProject.Models.Admin.main.Project_model>;
    var firstDayLastMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1);
    var lastDayLastMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddDays(-1);
    var data = ViewData["reportdata"] as List<RemoteSensingProject.Models.Admin.main.TechnicalInternalMonthlyReport>;
    var projectmanagerlist = ViewData["projectmanagerlist"] as List<RemoteSensingProject.Models.Admin.main.Employee_model>;
}


<style>
    .modal-body .sliderimages img {
        width: 20% !important;
        height: 20%;
        border-radius: 10px;
    }

    svg {
        height: 20px;
    }

    .custom-table {
        border: 2px solid #000;
    }

        .custom-table th,
        .custom-table td {
            border: 1px solid #000;
            vertical-align: middle;
            font-size: 14px;
        }

        .custom-table thead th {
            background-color: #d9d9d9;
            font-weight: 600;
        }

    .small-text {
        font-size: 12px;
    }
</style>

<nav class="page-breadcrumb mb-3">
    <div class="container-fluid">
        <div class="row align-items-end">

            <!-- Left side: Filters -->
            <div class="col-md-6">
                <div class="row g-3">

                    <!-- Year Dropdown -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label">वर्ष चुनें</label>
                        <select class="form-select" id="yearFilter">
                            <option value="">सभी</option>
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026">2026</option>
                        </select>
                    </div>

                    <!-- Month Dropdown -->
                    <div class="col-md-4 col-sm-6">
                        <label class="form-label">माह चुनें</label>
                        <select class="form-select" id="monthFilter">
                            <option value="">सभी</option>
                            <option value="1">जनवरी</option>
                            <option value="2">फरवरी</option>
                            <option value="3">मार्च</option>
                            <option value="4">अप्रैल</option>
                            <option value="5">मई</option>
                            <option value="6">जून</option>
                            <option value="7">जुलाई</option>
                            <option value="8">अगस्त</option>
                            <option value="9">सितंबर</option>
                            <option value="10">अक्टूबर</option>
                            <option value="11">नवंबर</option>
                            <option value="12">दिसंबर</option>
                        </select>
                    </div>

                </div>
            </div>

            <!-- Right side: Buttons -->
            <div class="col-md-6 d-flex justify-content-end gap-2 mt-3 mt-md-0">
                <button class="btn btn-outline-primary text-nowrap" id="downloadDocx">
                    <i class="link-icon" data-feather="download"></i>
                    Export Docx
                </button>

                <button class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#addslider">
                    <i class="link-icon" data-feather="plus"></i>
                    Add Monthly Status
                </button>
            </div>

        </div>
    </div>
</nav>
<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <p class="text-center">
                    <h2 class="text-center">मासिक समीक्षा : रूप पत्र - 2 </h2>
                    <h2 class="text-center">शासन से गैर वेतन मद में प्राप्त धनराषि से संचालित योजना / कार्यक्रमों की भौतिक उपलब्धियों का विवरण</h2>
                    <h2 class="text-center">विभाग का नाम : रिमोटे सेन्सिंग एप्लीकेसन्स सेंटर, उत्तर प्रदेश, विज्ञान एवं प्रोद्योगिकी विभाग, उत्तर प्रदेश  </h2>
                </p>
                <div class="table-responsive">
                    <table class="table custom-table">

                        <thead>
                            <!-- First Header Row -->
                            <tr>
                                <th rowspan="2">क्रम सं०</th>
                                <th rowspan="2">मद / परियोजना का नाम</th>
                                <th rowspan="2">इकाई (लाख मे)</th>
                                <th colspan="2">लक्ष्य</th>
                                <th colspan="2">उपलब्धि </th>
                                <th rowspan="2">प्रदेश  सरकार के लाभान्वित होने वाले विभाग </th>
                                <th rowspan="2">अभ्युक्ति</th>
                                <th rowspan="2">Action</th>
                            </tr>

                            <!-- Second Header Row -->
                            <tr>
                                <th>आलोच्य माह में  </th>
                                <th>आलोच्य मासांत तक क्रमिक </th>
                                <th>वार्षिक </th>
                                <th>आलोच्य मासांत तक</th>
                            </tr>

                            <!-- Column Number Row -->
                            <tr class="small-text">
                                <th>1</th>
                                <th>2</th>
                                <th>3</th>
                                <th>4</th>
                                <th>5</th>
                                <th>6</th>
                                <th>7</th>
                                <th>8</th>
                                <th>9</th>
                                <th>10</th>
                            </tr>
                            <!--Full collapse row-->
                            <tr>
                                <td class="fw-bold">1.0</td>
                                <td colspan="9">
                                    <h4>
                                        रीमोट सेन्सिंग तकनीक से प्रदेश के समस्त प्रकार्तिक संसधानों का अनुश्रवण एवं आलंकान
                                    </h4>
                                </td>
                            </tr>
                        </thead>

                        <tbody>
                            @if (data != null && data.Count > 0)
                            {
                                int count = 1;
                                foreach (var item in data)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.ProjectName</td>
                                        <td>@item.Amount</td>
                                        <td>@item.InMonthReview</td>
                                        <td>@item.EndMonthReview</td>
                                        <td>@item.FinancialYearlyAim</td>
                                        <td>@item.SequentiallyMonthReview</td>
                                        <td>@item.Statebeneficiary</td>
                                        <td>@item.Remark</td>
                                        <td>
                                            <a class="cursor-pointer edit-btn" data-id="@item.Id">
                                                <i class="link-icon" data-feather="edit"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    count++;
                                }
                            }
                        </tbody>

                    </table>
                </div>
                <div class="row mt-3">
                    <div class="col-12 text-end">
                        <button type="button" class="btn btn-primary" id="finalSubmitbtn">Final Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addslider" tabindex="-1" aria-labelledby="addslider" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title" id="exampleModalLabel">Add Monthly Progress Report</h5>
            </div>
            <div class="modal-body">
                <form class="forms-sample" id="weeklyUpdateForm">
                    <input type="hidden" id="editid" name="Id" value="" />
                    <div class="row">
                        <div class="mb-3 col-md-6">
                            <label for="subtitle" class="form-label">Date</label>
                            <input type="date" class="form-control form-control-sm" name="Date" min="@firstDayLastMonth.ToString("yyyy-MM-dd")"
                                   max="@lastDayLastMonth.ToString("yyyy-MM-dd")" />

                        </div>
                        <div class="mb-3 col-md-6">
                            <label for="projectHead" class="form-label"> मद / परियोजना का नाम </label>
                            <select class="form-select form-select-sm" id="projectname" name="ProjectId" required>
                                <option value="" selected>मद / परियोजना का नाम</option>
                                @if (projects != null)
                                {
                                    foreach (var item in projects)
                                    {
                                        <option value="@item.Id">@item.ProjectTitle</option>
                                    }
                                }
                            </select>
                        </div>

                        <label>वार्षिक लक्ष्य</label>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>वित्तीय</label>
                                <input type="text" class="form-control" placeholder="वित्तीय" name="FinancialYearlyAim" />
                            </div>
                            <div class="col-sm-6">
                                <label>आलोच्य मासांत तक </label>
                                <input type="text" class="form-control" placeholder="आलोच्य मासांत तक" name="EndMonthReview" />
                            </div>
                        </div>
                        <hr />
                        <label>उपलब्धि</label>
                        <div class="row">
                            <div class="col-sm-6">
                                <label>आलोच्य माह में </label>
                                <input type="text" class="form-control" placeholder="आलोच्य माह में" name="InMonthReview" />
                            </div>
                            <div class="col-sm-6">
                                <label>आलोच्य मासांत तक क्रमिक</label>
                                <input type="text" class="form-control" placeholder="आलोच्य मासांत तक क्रमिक" name="SequentiallyMonthReview" />
                            </div>
                        </div>

                        <hr />

                        <div class="mb-3 col-md-12">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <label class="form-label">
                                        इकाई (लाख में)
                                    </label>
                                    <input type="text" name="Amount" class="form-control form-control-sm" placeholder="इकाई (लाख में)" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label for="subtitle" class="form-label">प्रदेश सरकार के लाभान्वित होने वाले विभाग</label>
                            <input class="form-control form-control-sm" name="Statebeneficiary" id="tinymceExample" rows="10" placeholder="प्रदेश सरकार के लाभान्वित होने वाले विभाग" />
                        </div>

                        <div class="mb-3 col-md-12">
                            <label for="subtitle" class="form-label">अभियुक्ति</label>
                            <textarea class="form-control form-control-sm" name="Remark" id="tinymceExample" rows="10" placeholder="लाभान्वित होने वाले विभागों से किए गए संपर्क की वस्तुस्थिति"></textarea>
                        </div>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary"><i class="link-icon" data-feather="plus"></i> Update Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $('#finalSubmitbtn').on('click', function () {
        debugger
        Swal.fire({
            title: 'Please wait',
            text: 'Processing your request...',
            didOpen: () => {
                Swal.showLoading();
            },
            allowOutsideClick: false,
            allowEscapeKey: false
        });
        $.ajax({
            url: '/divisionhead/InternalReportFinalSubmit',
            type: 'get',
            success: function (res) {
                console.log(res);
                if (res.status) {
                    Swal.fire({
                        title: 'Success',
                        text: res.message,
                        icon: 'success'
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: res.message,
                        icon: 'error'
                    });
                }
            },
            error: function (err) {
                console.log(err);
            }
        })
    })

    $("#weeklyUpdateForm").on("submit", function (e) {
        e.preventDefault();
        Swal.fire({
            title: "Please wait ...",
            text: "Processing your request...",
            timer: 100000,
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        })

        let formData = $(this).serialize();
        $.ajax({
            url: "/Employee/UpdateWeekly",
            type: "post",
            data: formData,
            success: function (res) {
                if (res.status) {
                    Swal.fire({
                        title: "Successfully !",
                        text: res.message,
                        icon: "success",
                        didClose: () => {
                            location.reload(true)
                        }
                    })
                }
                else {
                    Swal.fire({
                        title: "Sorry !",
                        text: res.message,
                        icon: "warning"
                    })
                }
            },
            error: function () {
                Swal.fire({
                    title: "Server busy !",
                    text: "Server is busy ! Please try after sometime.",
                    icon: "error",
                    didClose: () => {
                        //location.reload(true)
                    }
                })
            }
        })
    })
    $(document).ready(function () {

        populateYear();
        populateMonth();

        // When year changes → reload months
        $("#yearFilter").on("change", function () {
            populateMonth();
        });

    });

    $('#projectname').on('change', function () {
        const id = $(this).val();

        if (id > 0) {
            BindData(id, "projectid");
        }
    });

    $('.edit-btn').on('click', function () {
        debugger
        const id = $(this).data("id");
        if (id > 0) {
            BindData(id, "editid")
        }
    })

    function BindData(id, type) {
        debugger
        $.ajax({
            url: '/employee/GetInternalTechnicalProjectReport',
            type: 'get',
            data: { id: id, type: type },
            success: function (res) {
                if (res.status && res.data.length > 0) {
                    function formatDate(dateStr) {
                        // "03-01-2026" -> "2026-01-03"
                        const parts = dateStr.split('-');
                        return `${parts[2]}-${parts[1]}-${parts[0]}`;
                    }

                    const d = res.data[0]; // first object

                    // modal show

                    // values set
                    $('input[name="Date"]').val(formatDate(d.DateString));
                    $('select[name="ProjectId"]').val(d.ProjectId);

                    $('input[name="FinancialYearlyAim"]').val(d.FinancialYearlyAim);
                    $('input[name="EndMonthReview"]').val(d.EndMonthReview);

                    $('input[name="InMonthReview"]').val(d.InMonthReview);
                    $('input[name="SequentiallyMonthReview"]').val(d.SequentiallyMonthReview);

                    $('input[name="Amount"]').val(d.Amount);

                    $('input[name="Statebeneficiary"]').val(d.Statebeneficiary);
                    $('textarea[name="Remark"]').val(d.Remark);

                    if (type == "editid") {
                        $('input[name="Id"]').val(d.Id);
                        $('#addslider').modal('show');
                    }
                } else { return; }
            },
            error: function (err) {
                console.log(err);
            }
        })
    }

    function populateYear() {

        const $yearSelect = $('#yearFilter');
        const currentYear = new Date().getFullYear();

        $yearSelect.empty();

        for (let y = currentYear - 4; y <= currentYear; y++) {
            $yearSelect.append(`<option value="${y}">${y}</option>`);
        }

        // ✅ Auto select current year
        $yearSelect.val(currentYear);
    }


    function populateMonth() {

        const $monthSelect = $("#monthFilter");
        const selectedYear = parseInt($("#yearFilter").val());

        const currentDate = new Date();
        const currentYear = currentDate.getFullYear();
        const currentMonth = currentDate.getMonth() + 1;

        $monthSelect.empty();

        let maxMonth = 12;

        // ✅ If current year → show till current month
        if (selectedYear === currentYear) {
            maxMonth = currentMonth;
        }

        const monthNames = [
            "जनवरी", "फरवरी", "मार्च", "अप्रैल",
            "मई", "जून", "जुलाई", "अगस्त",
            "सितंबर", "अक्टूबर", "नवंबर", "दिसंबर"
        ];

        for (let m = 1; m <= maxMonth; m++) {
            $monthSelect.append(
                `<option value="${m}">${monthNames[m - 1]}</option>`
            );
        }

        // ✅ Auto select current month (if current year)
        if (selectedYear === currentYear) {
            $monthSelect.val(currentMonth);
        }
    }

    $("#downloadDocx").click(function () {
        const year = $('#yearFilter').val() || null;
        const month = $('#monthFilter').val() || null;
        const division = $('#divisionFilter').val() || null;
        $.ajax({
            url: '/api/report/CombinedInternalProject_ProgressReport',
            type: 'GET',
            data: { month: month, year: year, id: division },
            xhrFields: {
                responseType: 'blob'
            },
            success: function (data, status, xhr) {

                var contentDisposition = xhr.getResponseHeader('Content-Disposition');
                var fileName = "Report.docx"; // fallback

                if (contentDisposition) {

                    var fileNameMatch = contentDisposition.match(/filename\*=utf-8''(.+)/i);

                    if (fileNameMatch && fileNameMatch.length > 1) {
                        fileName = decodeURIComponent(fileNameMatch[1]);
                    }
                }

                var blob = new Blob([data], {
                    type: xhr.getResponseHeader("Content-Type")
                });

                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            },
            error: function (err) {
                console.log(err);
                alert("Error downloading file");
            }
        });
    })
</script>

<script>
    // 🎯 Filters change events
    $('#yearFilter').on('change', function () {
        applyReportFilters();
    });

    $('#monthFilter').on('change', function () {
        applyReportFilters();
    });

    $('#divisionFilter').on('change', function () {
        applyReportFilters();
    });

    function applyReportFilters() {

        let year = $('#yearFilter').val();
        let month = $('#monthFilter').val();
        let division = $('#divisionFilter').val();

        const url = new URL(window.location.href);

        // year
        if (year) {
            url.searchParams.set("year", year);
        } else {
            url.searchParams.delete("year");
        }

        // month
        if (month) {
            url.searchParams.set("month", month);
        } else {
            url.searchParams.delete("month");
        }

        // division
        if (division) {
            url.searchParams.set("division", division);
        } else {
            url.searchParams.delete("division");
        }

        window.history.replaceState({}, "", url);

        clearTimeout(window.filterTimer);
        window.filterTimer = setTimeout(() => {
            window.location.href = url.toString();
        }, 400);
    }

    // 🔁 Reload ke baad filter values retain
    $(document).ready(function () {

        const urlParams = new URLSearchParams(window.location.search);

        const year = urlParams.get('year');
        const month = urlParams.get('month');
        const division = urlParams.get('division');

        if (year) {
            $('#yearFilter').val(year);
        }

        if (month) {
            $('#monthFilter').val(month);
        }

        if (division) {
            $('#divisionFilter').val(division);
        }
    });
</script>